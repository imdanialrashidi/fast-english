# Document required variable names only. Never add real values.
APP_ENV=development
APP_NAME=
APP_KEY=
APP_DEBUG=true
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=
LOG_LEVEL=debug

# S0: PostgreSQL is required for every local run and every DB test.
# No SQLite substitute. Test suite defaults live in phpunit.xml.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
# S8: development uses the log mailer, tests use the array mailer
# (phpunit.xml). Real SMTP stays BLOCKED (scope §25) — never commit
# credentials here; production SMTP lives in the server secret store.

VITE_APP_NAME="${APP_NAME}"

# S2 PWA/TWA (scope §18). Names only; values live in untracked env files.
# Staging host requires APP_ENV=staging, APP_DEBUG=false,
# SESSION_SECURE_COOKIE=true (see active exec plan). Package ID is a
# PROPOSAL, not owner-approved.
SW_VERSION=
TWA_PACKAGE_NAME=
TWA_SHA256_FINGERPRINT=

# S9a production (scope sections 16, 19.1, 25). Names and purpose only; no values.
# Coolify sets the real values at runtime (see docs/ops/COOLIFY.md).
# - APP_ENV=production enables X-Accel-Redirect private delivery and
#   disables fixture seeders (they throw in production; staging may run them).
# - APP_DEBUG=false hides traces (forced error page shows no stack).
# - APP_URL is the owner-provided HTTPS origin (canonical + storage URLs).
# - SESSION_SECURE_COOKIE=true so cookies require HTTPS behind the proxy.
#   Laravel trusts Coolify's proxy (bootstrap/app.php trustProxies '*')
#   so it sees HTTPS via X-Forwarded-Proto.
# - LOG_CHANNEL/LOG_STACK=stderr in production (never file); logs carry
#   counts/ages/bytes only, never receipts/tokens/secrets (S8-6, S9a-5).
# - MAIL_MAILER=smtp + MAIL_HOST/PORT/USERNAME/PASSWORD/FROM_* mean SMTP
#   is configured. When unset in production, password reset stays disabled:
#   POST /forgot-password and POST /reset-password return the neutral
#   message, send nothing, and log no token (S9a-5).
# - SALES_ENABLED stays false until real prices/destination/terms exist.
# S8 sales switch (scope section 25): OFF by default. Turn on only with real
# prices, a real destination, and approved terms/privacy in place.
SALES_ENABLED=false

# S8 staff 2FA (scope §5): enforcement is ON in production by default.
# Set explicitly in non-production only to rehearse the enforced flow.
STAFF_2FA_ENFORCE=
STAFF_2FA_IDLE_MINUTES=

# S8 release metadata (scope §18.2): filled ONLY from a real build.
# All empty until the first release — the download page shows
# «هنوز منتشر نشده» with no file, link, or checksum.
RELEASE_VERSION_NAME=
RELEASE_VERSION_CODE=
RELEASE_DATE=
RELEASE_SIZE_BYTES=
RELEASE_SHA256=
RELEASE_FILE_URL=
