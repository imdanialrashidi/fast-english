# Fast English Podcast — environment variable contract.
#
# Names only. Never add real values to this file or to any committed file.
# Classification legend (per variable):
#   [REQUIRED]    the build/deploy fails fast when missing
#   [REQUIRED-SECRET] required on the server, but only in the root-only
#                 secrets file (/opt/fast-english/shared/secrets/pocketbase.env)
#   [OPTIONAL]    safe default or honest disabled state when unset
#   [DISABLED]    intentionally off for launch; enabling needs an explicit decision
#
# Build-time fail-fast: the release bundle gate (scripts/check-production-bundle.sh)
# fails when a built surface still reports the pre-release 0.0.0 identity, when an
# APK URL/version is inconsistent (scripts/check-android-version.mjs), or when a
# configured value points at a debug/loopback/local target.

# --- Local development only -------------------------------------------------
# [OPTIONAL] Environment label. Never used to gate production behavior.
APP_ENV=development

# Android debug only: where the Capacitor WebView can reach PocketBase.
# [DISABLED] in production builds — a production APK must use the hard-coded
# production origin (https://app.fastenglishpodcast.com), never this variable.
# Expected workflow: `adb reverse tcp:8090 tcp:8090` and use http://localhost:8090
# VITE_ANDROID_API_ORIGIN=http://localhost:8090

# Local development PocketBase storage (scripts/dev.sh). Student accounts
# must survive PocketBase/app restarts, so the default data directory is the
# persistent server/pb_data. Set PB_DEV_EPHEMERAL=1 to use a disposable
# temp data dir instead (never the default). PB_DATA_DIR overrides the path.
# [OPTIONAL] a 32-char key that encrypts dev PocketBase settings when set;
# without it dev settings are stored unencrypted (never silently).
# PB_DEV_EPHEMERAL=0
# PB_DATA_DIR=/absolute/path/to/pb_data
# PB_DEV_ENCRYPTION_KEY=...

# --- Landing (static marketing site) — build-time configuration -------------
# [OPTIONAL] Web App origin the CTAs open. Safe production default when unset:
# https://app.fastenglishpodcast.com. The production bundle gate rejects any
# non-https/loopback value (scripts/check-production-bundle.sh).
VITE_WEB_APP_URL=https://app.fastenglishpodcast.com

# Official signed release APK only. Never a debug APK.
# [OPTIONAL] When unset the landing shows an honest "coming soon" Android
# state. When set, URL must be https on a real domain AND consistent with
# the Android versionName (pnpm android:check:version).
# VITE_ANDROID_APK_URL=https://fastenglishpodcast.com/releases/fast-english-podcast-v1.0.0.apk
# VITE_ANDROID_APK_VERSION=1.0.0

# --- Android Release signing (P4-S2 signing-key safety gate) ----------------
# [REQUIRED] for a signed Release APK build and nothing else. Document
# required variable names only — never add real values, never commit a
# keystore. The Release APK build fails safely («Production signing
# material: REQUIRED») until all four are set. The debug key must never
# sign the distributable APK. Values live in the operator's environment,
# never in the repo.
# FEP_ANDROID_KEYSTORE_PATH=/absolute/path/to/fast-english-release.jks
# FEP_ANDROID_KEY_ALIAS=fast-english
# FEP_ANDROID_KEYSTORE_PASSWORD=...
# FEP_ANDROID_KEY_PASSWORD=...

# --- Staff/bootstrap, seeding and content-CLI operations --------------------
# Names only — never add real values. The staff account is created via
# `pnpm staff:bootstrap`; the seed tools require superuser credentials and
# explicit --target/--confirm-production intent before touching anything
# non-loopback. Production values belong in the server secrets file, not here.
# FEP_PB_URL=https://app.fastenglishpodcast.com
# FEP_PB_SUPERUSER_EMAIL=...
# FEP_PB_SUPERUSER_PASSWORD=...
# FEP_STAFF_EMAIL=...
# FEP_STAFF_PASSWORD=...
# FEP_STAFF_DISPLAY_NAME=...

# [OPTIONAL] Content packages root for the content CLI (pnpm content:new|validate).
# FEP_CONTENT_DIR=/absolute/path/to/content-packages

# App dev server: API proxy target (vite.app.config.ts). Defaults to the
# local PocketBase on 127.0.0.1:8090. [OPTIONAL] — dev only; production Caddy
# proxies /api/* to PocketBase, this variable is never read by a production
# build's runtime path.
# VITE_API_TARGET=http://127.0.0.1:8090

# Telemetry beacon endpoint (app + landing telemetry).
# [DISABLED] at launch: when unset, telemetry stays in the bounded in-memory
# ring buffer and NO network egress occurs. Enabling is an explicit decision
# (see docs/OBSERVABILITY.md).
# VITE_TELEMETRY_ENDPOINT=https://...

# Local PocketBase listen port for scripts/dev.sh (default 8090).
# [OPTIONAL]
# PB_PORT=8090
