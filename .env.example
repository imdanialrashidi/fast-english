# Document required variable names only. Never add real values.
APP_ENV=development

# Android debug only: where the Capacitor WebView can reach PocketBase.
# Expected workflow: `adb reverse tcp:8090 tcp:8090` and use http://localhost:8090
# VITE_ANDROID_API_ORIGIN=http://localhost:8090

# Landing (static marketing site) — build-time configuration.
# Web App default when unset: https://app.fastenglishpodcast.com
VITE_WEB_APP_URL=https://app.fastenglishpodcast.com

# Official signed release APK only (provided in P4-S2). Never a debug APK.
# When unset the landing shows an honest "coming soon" Android state.
# VITE_ANDROID_APK_URL=https://fastenglishpodcast.com/releases/fast-english-podcast-0.1.0.apk
# VITE_ANDROID_APK_VERSION=0.1.0

# Android Release signing (P4-S2 signing-key safety gate). Document required
# variable names only — never add real values, and never commit a keystore.
# The Release APK build fails safely until all four are set. The debug key
# must never sign the distributable APK.
# FEP_ANDROID_KEYSTORE_PATH=/absolute/path/to/fast-english-release.jks
# FEP_ANDROID_KEY_ALIAS=fast-english
# FEP_ANDROID_KEYSTORE_PASSWORD=...
# FEP_ANDROID_KEY_PASSWORD=...

# Optional support/contact channel (https URL). When unset, contact and
# collaboration pages show an honest "not announced yet" state.
# VITE_SUPPORT_URL=https://t.me/your-channel
