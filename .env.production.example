# Fast English — production environment template (Coolify secret store).
#
# Names and safe defaults only. Paste the real values in the Coolify UI;
# never commit them, and never reuse the local .env. See docs/ops/COOLIFY.md.
#
# Generate APP_KEY once and keep it forever:
#   docker run --rm php:8.4-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# Rotating APP_KEY invalidates every session and encrypted payload.

APP_NAME="Fast English"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://fastenglishpodcast.ir

# Locale is fixed to `fa` in config/app.php; the staff panel pins `en`.
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Logs go to Docker/Coolify stdout-stderr. Never add a file channel in
# production: ops:status reads a file log that does not exist here.
LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_LEVEL=warning

# PostgreSQL 17 (Coolify database resource, internal hostname, no public port).
# Compose path (compose.prod.yml): DB_HOST/DB_DATABASE/DB_USERNAME are fixed
# by the stack; only DB_PASSWORD is needed (scripts/coolify-env.sh generates it).
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer

# Sessions/cache/queue all live in the database (no Redis in this scope).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# Private disk: audio + receipts stay under storage/app/private and never
# reach the public disk, CDN cache, or service worker.
FILESYSTEM_DISK=local

# Leave MAIL_MAILER=log until real SMTP credentials exist. Without SMTP,
# password reset short-circuits with a neutral message (no send, no token).
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@fastenglishpodcast.ir"
MAIL_FROM_NAME="${APP_NAME}"

# Commercial switch: stays false until a real card destination, approved
# terms/privacy, and real prices are in place. Sales off shows the
# «در دست آماده‌سازی» state and refuses payment creation server-side.
SALES_ENABLED=false

# Staff TOTP is enforced in production by default. Keep it explicit.
STAFF_2FA_ENFORCE=true
STAFF_2FA_IDLE_MINUTES=30

# Release metadata. Empty values fall back to the measured 1.0.0 defaults
# committed in config/release.php when APP_ENV=production. Set these only to
# override a future build; never paste invented values.
RELEASE_VERSION_NAME=
RELEASE_VERSION_CODE=
RELEASE_DATE=
RELEASE_SIZE_BYTES=
RELEASE_SHA256=
RELEASE_FILE_URL=

# PWA / TWA. Package and certificate fingerprint are public values; empty
# production values fall back to the released 1.0.0 build (config/pwa.php).
SW_VERSION=
TWA_PACKAGE_NAME=
TWA_SHA256_FINGERPRINT=
