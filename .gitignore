# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Android signing material and release artifacts (P4-S2 signing-key gate).
# Production keystores, passwords and signing properties must never be
# committed; passwords come from the environment or an ignored local file.
releases/
*.jks
*.keystore
keystore.properties
keystore.properties.*
*.storepass
*.keypass

# Confidential project/client material
docs/private/**
!docs/private/.gitkeep

# Dependencies and environments
node_modules/
.pnpm-store/
.venv/
venv/
vendor/

# Build, test, and framework output
dist/
build/
coverage/
target/
.next/
.turbo/
.vite/
dist-app/
dist-landing/
dist-landing-apk/
playwright-report/
test-results/
*.log

# PocketBase
server/pb_data/
server/pocketbase
server/pocketbase.exe

# Editors / OS
.idea/
.vscode/
.DS_Store
