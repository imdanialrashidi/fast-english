{
  "settings": {
    "toolPrefix": "none",
    "idleTimeout": 5,
    "requestTimeoutMs": 120000,
    "mcpFooterStatus": "compact",
    "hostConfigDiscovery": "off",
    "scriptMode": false,
    "sampling": false,
    "elicitation": false,
    "outputGuard": {
      "maxBytes": 51200,
      "maxLines": 2000,
      "detailsMaxBytes": 16384
    }
  },
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.79",
        "--headless",
        "--isolated",
        "--block-service-workers",
        "--image-responses",
        "omit",
        "--output-dir",
        ".artifacts/playwright",
        "--console-level",
        "warning",
        "--timeout-action",
        "10000",
        "--timeout-navigation",
        "90000"
      ],
      "lifecycle": "lazy",
      "idleTimeout": 5,
      "requestTimeoutMs": 120000,
      "toolPrefix": "none",
      "includeTools": [
        "browser_close",
        "browser_console_messages",
        "browser_find",
        "browser_network_request",
        "browser_network_requests",
        "browser_navigate",
        "browser_navigate_back",
        "browser_resize",
        "browser_snapshot",
        "browser_take_screenshot",
        "browser_tabs",
        "browser_wait_for",
        "browser_click",
        "browser_fill_form",
        "browser_handle_dialog",
        "browser_hover",
        "browser_press_key",
        "browser_select_option",
        "browser_type",
        "browser_evaluate"
      ],
      "excludeTools": [
        "browser_file_upload",
        "browser_drop"
      ]
    }
  }
}
