# Project-local Pi launcher switchboard.
# Leave PI_MAIN_MODEL empty to use the model selected through Pi's /model UI.
# Examples use Pi model IDs, not OpenCode provider/model IDs.

# A reusable template must not silently route code, screenshots, or prompts to a
# particular provider. Leave these empty and select through /model, or pin an
# a reviewed project-specific profile here.
export PI_MAIN_MODEL="opencode-go/deepseek-v4-flash"
export PI_MAIN_THINKING="max"
export PI_ENABLED_MODELS=""

# The delegated vision model is intentionally separate from the primary model.
# Configure it with `/vision model` or `/vision-use provider/model-id`; the
# extension persists that user-level choice in ~/.pi/agent/vision.json.

# Startup/network posture. Override in your shell when needed.
export PI_TELEMETRY="0"
export PI_SKIP_VERSION_CHECK="1"
export PI_CACHE_RETENTION="long"
