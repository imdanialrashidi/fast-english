# Project-local launcher defaults. Model, provider, and reasoning level are
# intentionally not pinned: Pi uses the operator's authenticated selection.
# Override per run when desired, for example:
#   PI_MAIN_MODEL="provider/model-id" PI_MAIN_THINKING="high" ./p

export PI_TELEMETRY="${PI_TELEMETRY:-0}"
export PI_SKIP_VERSION_CHECK="${PI_SKIP_VERSION_CHECK:-1}"
export PI_CACHE_RETENTION="${PI_CACHE_RETENTION:-long}"

# The reviewed Pi 0.84.2 pin uses this for capability-gated, strict-prefer
# built-in JSON-schema sampling and its official first-run setup. Set 0 to opt out.
export PI_EXPERIMENTAL="${PI_EXPERIMENTAL:-1}"
export PI_SMART_READ="${PI_SMART_READ:-1}"
export PI_SMART_READ_BYTES="${PI_SMART_READ_BYTES:-98304}"
export PI_SMART_READ_LINES="${PI_SMART_READ_LINES:-400}"
export PI_BLIND_RETRY_LIMIT="${PI_BLIND_RETRY_LIMIT:-2}"
export PI_CONTINUITY="${PI_CONTINUITY:-1}"
