{
  "defaultThinkingLevel": "high",
  "enableInstallTelemetry": false,

  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 24000
  },

  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "baseDelayMs": 3000,
    "provider": {
      "timeoutMs": 900000,
      "maxRetries": 0,
      "maxRetryDelayMs": 120000
    }
  },

  "httpIdleTimeoutMs": 600000,

  "packages": [
    "npm:pi-sub-agent@0.1.5",
    {
      "source": "npm:pi-mcp-adapter@2.20.1",
      "skills": []
    },
    "npm:@juicesharp/rpiv-todo@2.1.0",
    "npm:pi-lsp-adapter@0.1.3",
    "npm:@dreki-gg/pi-doc-search@0.3.2",
    "npm:@getpipher/vision@0.5.2",
    "npm:@bytetrue/pi-web-search@0.1.3"
  ]
}
