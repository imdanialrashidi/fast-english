{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": [
      "**",
      "!dist-app",
      "!dist-landing",
      "!node_modules",
      "!**/node_modules",
      "!.vite",
      "!coverage",
      "!server/pb_data",
      "!server/pb_data.bak",
      "!server/pocketbase",
      "!server/pb_migrations",
      "!android",
      "!build",
      "!playwright-report",
      "!test-results",
      "!fast_english_logo_assets",
      "!shared/assets/brand",
      "!dist-landing-apk",
      "!dist-admin",
      "!.pi",
      "!.mcp.json",
      "!.artifacts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": {
        "noImportantStyles": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["server/pb_hooks/**/*.pb.js"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
