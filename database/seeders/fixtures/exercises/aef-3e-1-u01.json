  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "verb be [+], subject pronouns",
      "title_fa": "فعل be مثبت و ضمیرهای فاعلی",
      "use_fa": "برای معرفی خودمان و دیگران. هر جمله به ضمیر فاعلی نیاز دارد و فعل be با فاعل هماهنگ می‌شود.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "I am (I'm)\nYou are (You're)\nHe / She / It is (He's / She's / It's)\nWe / You / They are (We're / You're / They're)"
        },
        {
          "label_fa": "قاعده",
          "text": "I'm a student.\nIt's a school. (نه Is a school.)\nHe's Ben and I'm Sally. (I همیشه بزرگ)"
        }
      ],
      "examples": [
        {
          "en": "I'm a student.",
          "fa": "من دانشجو هستم."
        },
        {
          "en": "You're my partner.",
          "fa": "تو هم‌گروه من هستی."
        },
        {
          "en": "She's in my class.",
          "fa": "او در کلاس من است."
        },
        {
          "en": "They're teachers.",
          "fa": "آن‌ها معلم‌اند."
        }
      ],
      "notes_fa": "subject pronoun همیشه لازم است: It's a school. (نه Is a school.) برای یک مرد he، برای یک زن she و برای چیز it؛ they برای افراد و چیزها."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "verb be [- and [?]",
      "title_fa": "فعل be منفی و سؤالی",
      "use_fa": "برای منفی کردن، not بعد از be می‌آید؛ برای سؤال، am/is/are قبل از فاعل می‌آید. پاسخ کوتاه بدون کوتاه‌نویسی است.",
      "formulas": [
        {
          "label_fa": "منفی",
          "text": "I'm not ...\nHe / She / It isn't ...\nYou / We / They aren't ..."
        },
        {
          "label_fa": "سؤالی",
          "text": "Am / Are / Is + subject ...?\nAre you Turkish?\nWhere are you from?"
        },
        {
          "label_fa": "پاسخ کوتاه",
          "text": "Yes, I am. / No, I'm not.\nYes, she is. / No, she isn't.\n(نه Yes, I'm.)"
        }
      ],
      "examples": [
        {
          "en": "I'm not American.",
          "fa": "من آمریکایی نیستم."
        },
        {
          "en": "She isn't from London.",
          "fa": "او اهل لندن نیست."
        },
        {
          "en": "Are you Brazilian? — Yes, I am.",
          "fa": "برزیلی هستی؟ — بله."
        },
        {
          "en": "Where are you from?",
          "fa": "اهل کجایی؟"
        }
      ],
      "notes_fa": "در پاسخ کوتاه مثبت، کوتاه‌نویسی نمی‌آید: Yes, I am. (نه Yes, I'm.) در سؤال، کلمهٔ پرسشی اول و بعد فعل be می‌آید: Where are you from?"
    },
    {
      "key": "t3",
      "position": 3,
      "title_en": "possessive adjectives",
      "title_fa": "صفات ملکی",
      "use_fa": "نشان می‌دهد چیزی مال چه کسی است. قبل از اسم می‌آید و با مفرد و جمع تغییر نمی‌کند.",
      "formulas": [
        {
          "label_fa": "جدول",
          "text": "I → my\nYou → your\nHe → his\nShe → her\nIt → its\nWe → our\nThey → their"
        },
        {
          "label_fa": "مثال",
          "text": "My family is from Peru.\nHis name is Michael.\nTheir names are Luc and Marie."
        }
      ],
      "examples": [
        {
          "en": "My family is from Cusco.",
          "fa": "خانوادهٔ من اهل کوسکو است."
        },
        {
          "en": "This is your classroom.",
          "fa": "این کلاس شماست."
        },
        {
          "en": "Her name is Tina.",
          "fa": "اسم او تیناست."
        },
        {
          "en": "Its name is English House.",
          "fa": "اسمش انگلیسی هاوس است."
        }
      ],
      "notes_fa": "its (مالِ آن) با it's (it is) فرق دارد. صفت ملکی جمع بسته نمی‌شود: our students (نه ours students)."
    }
  ],
