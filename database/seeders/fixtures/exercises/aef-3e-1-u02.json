  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "singular and plural nouns",
      "title_fa": "اسم‌های مفرد و جمع",
      "use_fa": "a/an قبل از اسم مفرد می‌آید و برای جمع استفاده نمی‌شود. جمع با s/es/ies ساخته می‌شود و some اسم‌ها بی‌قاعده‌اند.",
      "formulas": [
        {
          "label_fa": "مفرد",
          "text": "a book / an umbrella\na + consonant sound\nan + vowel sound"
        },
        {
          "label_fa": "جمع",
          "text": "book → books\nwatch → watches\ncity → cities\nman → men / woman → women / child → children / person → people"
        },
        {
          "label_fa": "the",
          "text": "the board (مشخص)\nthe + singular or plural"
        }
      ],
      "examples": [
        {
          "en": "It's a book.",
          "fa": "این یک کتاب است."
        },
        {
          "en": "They're watches.",
          "fa": "این‌ها ساعت مچی‌اند."
        },
        {
          "en": "They're dictionaries.",
          "fa": "این‌ها فرهنگ لغت‌اند."
        },
        {
          "en": "Two children are in the room.",
          "fa": "دو کودک در اتاق هستند."
        }
      ],
      "notes_fa": "با جمع، a/an نمی‌آید: They're books. (نه They're a books.) در اسم‌های دوکلمه‌ای فقط کلمهٔ دوم جمع می‌شود: credit cards."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "adjectives",
      "title_fa": "صفت‌ها",
      "use_fa": "صفت قبل از اسم یا بعد از فعل be می‌آید، برای مفرد و جمع یک شکل دارد و با very/really تقویت می‌شود.",
      "formulas": [
        {
          "label_fa": "قبل از اسم",
          "text": "adjective + noun\nIt's a beautiful picture.\nThey're blue jeans."
        },
        {
          "label_fa": "بعد از be",
          "text": "subject + be + adjective\nMy car's new.\nThe computer isn't cheap."
        },
        {
          "label_fa": "تقویت",
          "text": "very / really + adjective\nHe's very tall."
        }
      ],
      "examples": [
        {
          "en": "It's a beautiful picture.",
          "fa": "این یک تصویر زیباست."
        },
        {
          "en": "They're blue jeans.",
          "fa": "این شلوار جین آبی است."
        },
        {
          "en": "Is your car new?",
          "fa": "ماشینت نو است؟"
        },
        {
          "en": "We're really tired.",
          "fa": "ما واقعاً خسته‌ایم."
        }
      ],
      "notes_fa": "صفت جمع بسته نمی‌شود: blue jeans (نه blues jeans). ترتیب: صفت قبل از اسم، نه بعد از آن: a beautiful picture (نه a picture beautiful)."
    },
    {
      "key": "t3",
      "position": 3,
      "title_en": "imperatives, let's",
      "title_fa": "امری و let's",
      "use_fa": "برای دستور و راهنمایی. امری با فعل پایه شروع می‌شود و منفی‌اش Don't است. let's برای پیشنهاد کار گروهی است.",
      "formulas": [
        {
          "label_fa": "امری",
          "text": "base verb + ...\nOpen the door.\nBe quiet, please."
        },
        {
          "label_fa": "امری منفی",
          "text": "Don't + base verb\nDon't worry.\nDon't stop."
        },
        {
          "label_fa": "پیشنهاد",
          "text": "Let's + base verb\nLet's go home.\nLet's not stop."
        }
      ],
      "examples": [
        {
          "en": "Open the door.",
          "fa": "در را باز کن."
        },
        {
          "en": "Don't worry.",
          "fa": "نگران نباش."
        },
        {
          "en": "Be quiet, please.",
          "fa": "لطفاً ساکت باش."
        },
        {
          "en": "Let's go home.",
          "fa": "بیا خانه برویم."
        }
      ],
      "notes_fa": "در امری فاعل نمی‌آید. let's منفی می‌شود let's not: Let's not stop."
    }
  ],
