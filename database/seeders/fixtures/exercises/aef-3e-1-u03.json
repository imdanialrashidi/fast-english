  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "simple present [+] and [-]",
      "title_fa": "حال ساده مثبت و منفی",
      "use_fa": "برای عادت‌ها و چیزهایی که به‌طور کلی درست‌اند. با he/she/it فعل s می‌گیرد و منفی با don't/doesn't ساخته می‌شود.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "I / You / We / They + base verb\nHe / She / It + verb-s\nShe watches TV."
        },
        {
          "label_fa": "منفی",
          "text": "I / You / We / They + don't + base verb\nHe / She / It + doesn't + base verb\nHe doesn't play the guitar."
        }
      ],
      "examples": [
        {
          "en": "I speak English.",
          "fa": "من انگلیسی صحبت می‌کنم."
        },
        {
          "en": "My mother cooks great food.",
          "fa": "مادرم غذای عالی می‌پزد."
        },
        {
          "en": "He doesn't play the guitar.",
          "fa": "او گیتار نمی‌زند."
        },
        {
          "en": "They like fast food.",
          "fa": "آن‌ها فست‌فود دوست دارند."
        }
      ],
      "notes_fa": "بعد از doesn't فعل پایه می‌آید: He doesn't work. (نه doesn't works.) سوم‌شخص مثل جمع اسم است: watch→watches، study→studies، go→goes."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "simple present [?]",
      "title_fa": "حال ساده سؤالی",
      "use_fa": "برای پرسیدن دربارهٔ عادت‌ها. سؤال با Do یا Does شروع می‌شود و فعل پایه می‌آید.",
      "formulas": [
        {
          "label_fa": "سؤالی",
          "text": "Do + I / you / we / they + base verb?\nDoes + he / she / it + base verb?\nDoes he work at night?"
        },
        {
          "label_fa": "پاسخ کوتاه",
          "text": "Yes, I do. / No, I don't.\nYes, he does. / No, he doesn't."
        }
      ],
      "examples": [
        {
          "en": "Do you live in New York?",
          "fa": "در نیویورک زندگی می‌کنی؟"
        },
        {
          "en": "Does he work at night?",
          "fa": "او شب‌ها کار می‌کند؟"
        },
        {
          "en": "Yes, I do. / No, he doesn't.",
          "fa": "بله. / نه."
        },
        {
          "en": "Where does he live?",
          "fa": "او کجا زندگی می‌کند؟"
        }
      ],
      "notes_fa": "در سؤال، فعل بعد از فاعل پایه است: Does she live ...? (نه Does she lives.)"
    },
    {
      "key": "t3",
      "position": 3,
      "title_en": "word order in questions",
      "title_fa": "ترتیب کلمات در سؤال",
      "use_fa": "در سؤال با be، فعل قبل از فاعل می‌آید؛ در سؤال با فعل معمولی، do/does قبل از فاعل و فعل پایه بعد از آن.",
      "formulas": [
        {
          "label_fa": "با be",
          "text": "be + subject + ...?\nIs she from Peru?\nWhere's your office?"
        },
        {
          "label_fa": "با do/does",
          "text": "question word + do/does + subject + base verb?\nWhere does he live?\nWhat do you do?"
        }
      ],
      "examples": [
        {
          "en": "Is she from Peru?",
          "fa": "او اهل پروست؟"
        },
        {
          "en": "Where's your office?",
          "fa": "دفترت کجاست؟"
        },
        {
          "en": "What do you do?",
          "fa": "چه کار می‌کنی؟"
        },
        {
          "en": "How many children do you have?",
          "fa": "چند فرزند داری؟"
        }
      ],
      "notes_fa": "با فعل be از do استفاده نمی‌کنیم: Is she ...? (نه Does she be ...?). کلمهٔ پرسشی اول جمله می‌آید."
    }
  ],
