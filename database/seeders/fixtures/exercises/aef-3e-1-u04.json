  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "possessive 's, Whose...?",
      "title_fa": "مالکیت با 's و Whose",
      "use_fa": "برای گفتن اینکه چیزی مال کیست: اسم شخص + 's. برای جمعی که به s ختم می‌شود فقط آپاستروف می‌آید. Whose برای پرسیدن مالکیت است.",
      "formulas": [
        {
          "label_fa": "مالکیت",
          "text": "person + 's + noun\nMaria's car\nJames's laptop"
        },
        {
          "label_fa": "جمع",
          "text": "plural + ' + noun\nmy parents' car\nirregular plural + 's: the children's room"
        },
        {
          "label_fa": "سؤالی",
          "text": "Whose bag is this?\nIt's Maria's.\nWho's = Who is"
        }
      ],
      "examples": [
        {
          "en": "He's Brad Pitt's brother.",
          "fa": "او برادر برد پیت است."
        },
        {
          "en": "It's my parents' car.",
          "fa": "این ماشین والدین من است."
        },
        {
          "en": "Whose bag is this? — It's Maria's.",
          "fa": "این کیف کیست؟ — مال ماریاست."
        },
        {
          "en": "The children's room is big.",
          "fa": "اتاق بچه‌ها بزرگ است."
        }
      ],
      "notes_fa": "برای چیزها معمولاً 's نمی‌آید: the end of the movie (نه the movie's end). Who's یعنی who is ولی Whose یعنی «مالِ کی»."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "prepositions of time and place",
      "title_fa": "حروف اضافهٔ زمان و مکان",
      "use_fa": "in برای بخش‌های روز، ماه، سال و فصل؛ on برای روزها و تاریخ؛ at برای ساعت و مکان‌های ثابت مثل home و work. to برای حرکت.",
      "formulas": [
        {
          "label_fa": "زمان",
          "text": "in the morning / in 2018 / in December\non Monday / on the weekend\nat three o'clock / at night"
        },
        {
          "label_fa": "مکان",
          "text": "at work / at home / at school\nin an office / in a room\nto the gym (movement)"
        },
        {
          "label_fa": "home",
          "text": "go home (بدون to)"
        }
      ],
      "examples": [
        {
          "en": "I watch TV in the evening.",
          "fa": "من عصرها تلویزیون تماشا می‌کنم."
        },
        {
          "en": "We have English on Monday.",
          "fa": "ما دوشنبه‌ها انگلیسی داریم."
        },
        {
          "en": "The class starts at three o'clock.",
          "fa": "کلاس ساعت سه شروع می‌شود."
        },
        {
          "en": "She goes to the gym.",
          "fa": "او به باشگاه می‌رود."
        }
      ],
      "notes_fa": "قبل از home حرف to نمی‌آید: go home. برای مکان‌های عمومی گاهی in و at هر دو می‌آیند: at the restaurant / in a restaurant."
    },
    {
      "key": "t3",
      "position": 3,
      "title_en": "position of adverbs, expressions of frequency",
      "title_fa": "جای قید تکرار و عبارت‌های تکرار",
      "use_fa": "می‌گویند کاری چند وقت یک‌بار انجام می‌شود. قید قبل از فعل اصلی و بعد از be می‌آید؛ عبارت‌هایی مثل twice a week در پایان جمله‌اند.",
      "formulas": [
        {
          "label_fa": "جای قید",
          "text": "subject + adverb + main verb\nI always watch TV.\nShe doesn't often go to bed late."
        },
        {
          "label_fa": "با be",
          "text": "subject + be + adverb\nHe's never stressed.\nAre you usually here?"
        },
        {
          "label_fa": "عبارت تکرار",
          "text": "at the end: twice a week / every day"
        }
      ],
      "examples": [
        {
          "en": "I always watch TV in the evening.",
          "fa": "من همیشه عصرها تلویزیون تماشا می‌کنم."
        },
        {
          "en": "She sometimes plays sports.",
          "fa": "او گاهی ورزش می‌کند."
        },
        {
          "en": "He's never stressed.",
          "fa": "او هرگز استرس ندارد."
        },
        {
          "en": "I have English classes twice a week.",
          "fa": "من هفته‌ای دو بار کلاس انگلیسی دارم."
        }
      ],
      "notes_fa": "با never و hardly ever فعل مثبت است: He never eats meat. (نه doesn't never). قید بعد از be می‌آید: He's never late."
    }
  ],
