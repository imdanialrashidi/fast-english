  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "can / can't",
      "title_fa": "can و can't",
      "use_fa": "برای توانایی، امکان و اجازه. can برای همهٔ فاعل‌ها یک شکل دارد و بعد از آن فعل پایه می‌آید.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "subject + can + base verb\nI can sing.\nYou can park here."
        },
        {
          "label_fa": "منفی",
          "text": "subject + can't + base verb\nI can't dance.\n(can't = cannot)"
        },
        {
          "label_fa": "سؤالی",
          "text": "Can + subject + base verb?\nCan you help me?\nYes, I can. / No, I can't."
        }
      ],
      "examples": [
        {
          "en": "I can sing, but I can't dance.",
          "fa": "می‌توانم بخوانم، ولی نمی‌توانم برقصم."
        },
        {
          "en": "Can you help me?",
          "fa": "می‌توانی کمکم کنی؟"
        },
        {
          "en": "You can park here.",
          "fa": "می‌توانی اینجا پارک کنی."
        },
        {
          "en": "She can't come on Wednesday.",
          "fa": "او چهارشنبه نمی‌تواند بیاید."
        }
      ],
      "notes_fa": "can با هیچ فاعلی s نمی‌گیرد و بعد از آن to نمی‌آید: I can swim. (نه I can to swim.)"
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "present continuous",
      "title_fa": "حال استمراری",
      "use_fa": "برای کاری که همین حالا یا همین روزها در جریان است. با am/is/are + فعل ing ساخته می‌شود.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "I'm + verb-ing\nYou / We / They are + verb-ing\nHe / She / It is + verb-ing"
        },
        {
          "label_fa": "منفی",
          "text": "I'm not + verb-ing\nYou aren't + verb-ing\nHe isn't + verb-ing"
        },
        {
          "label_fa": "سؤالی",
          "text": "Are you + verb-ing?\nIs he + verb-ing?\nWhat are you doing?"
        }
      ],
      "examples": [
        {
          "en": "They're having a party.",
          "fa": "آن‌ها مهمانی دارند."
        },
        {
          "en": "The baby's crying.",
          "fa": "بچه گریه می‌کند."
        },
        {
          "en": "It's raining.",
          "fa": "باران می‌بارد."
        },
        {
          "en": "What are you doing? — I'm waiting for my brother.",
          "fa": "چه کار می‌کنی؟ — منتظر برادرم هستم."
        }
      ],
      "notes_fa": "قواعد ing: cook→cooking، dance→dancing، shop→shopping (صامت آخر دوبرابر). حال استمراری برای «همین حالا» است."
    },
    {
      "key": "t3",
      "position": 3,
      "title_en": "simple present or present continuous?",
      "title_fa": "حال ساده یا حال استمراری؟",
      "use_fa": "حال ساده برای عادت و کارهای همیشگی؛ حال استمراری برای همین حالا یا دورهٔ موقت. نشانه‌های زمانی کمک می‌کنند.",
      "formulas": [
        {
          "label_fa": "حال ساده",
          "text": "always / usually / every day + simple present\nIt always snows here.\nMy sister works in a bank."
        },
        {
          "label_fa": "حال استمراری",
          "text": "now / at the moment / today + present continuous\nLook! It's snowing.\nToday she's working at home."
        }
      ],
      "examples": [
        {
          "en": "It always snows here in the winter.",
          "fa": "اینجا زمستان‌ها همیشه برف می‌بارد."
        },
        {
          "en": "Look! It's snowing.",
          "fa": "نگاه کن! دارد برف می‌بارد."
        },
        {
          "en": "What do you do? — I'm a teacher.",
          "fa": "چه کار می‌کنی؟ — معلمم."
        },
        {
          "en": "What are you doing? — I'm waiting for a friend.",
          "fa": "چه کار می‌کنی؟ — منتظر دوستم هستم."
        }
      ],
      "notes_fa": "What do you do? یعنی «شغلت چیست؟» ولی What are you doing? یعنی «الان چه کار می‌کنی؟»"
    }
  ],
