  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "object pronouns",
      "title_fa": "ضمیرهای مفعولی",
      "use_fa": "ضمیر مفعولی جای اسمی می‌آید که مفعول فعل یا بعد از حرف اضافه است: me, you, him, her, it, us, them.",
      "formulas": [
        {
          "label_fa": "جدول",
          "text": "I → me\nYou → you\nHe → him\nShe → her\nIt → it\nWe → us\nThey → them"
        },
        {
          "label_fa": "جای ضمیر",
          "text": "after a verb: I love you.\nafter a preposition: Listen to me!"
        }
      ],
      "examples": [
        {
          "en": "Can you help me?",
          "fa": "می‌توانی کمکم کنی؟"
        },
        {
          "en": "I love you.",
          "fa": "دوستت دارم."
        },
        {
          "en": "She doesn't love him.",
          "fa": "او او را دوست ندارد."
        },
        {
          "en": "Wait for us!",
          "fa": "منتظر ما بمان!"
        }
      ],
      "notes_fa": "ضمیر مفعولی بعد از فعل می‌آید، نه قبل از آن: I love you. (نه I you love.) بعد از حرف اضافه هم مفعولی است: with her، to him."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "like + (verb + -ing)",
      "title_fa": "like + فعل ing‌دار",
      "use_fa": "برای گفتن اینکه از چه کاری خوشمان می‌آید. بعد از like/love/don't mind/hate/enjoy/prefer فعل ing می‌گیرد.",
      "formulas": [
        {
          "label_fa": "الگو",
          "text": "like / love / don't mind / hate / enjoy / prefer + verb-ing\nI love shopping.\nI don't mind getting up early."
        },
        {
          "label_fa": "قواعد ing",
          "text": "cook → cooking\nstudy → studying\ndance → dancing\nshop → shopping (دوبرابر)"
        }
      ],
      "examples": [
        {
          "en": "I love shopping.",
          "fa": "من عاشق خرید کردن هستم."
        },
        {
          "en": "I don't mind getting up early.",
          "fa": "زود بیدار شدن برایم مهم نیست."
        },
        {
          "en": "I hate doing housework.",
          "fa": "از کار خانه متنفرم."
        },
        {
          "en": "I enjoy watching soccer on TV.",
          "fa": "از تماشای فوتبال در تلویزیون لذت می‌برم."
        }
      ],
      "notes_fa": "بعد از این فعل‌ها فعل پایه نمی‌آید: I like reading. (نه I like read.)"
    },
    {
      "key": "t3",
      "position": 3,
      "title_en": "be or do?",
      "title_fa": "be یا do؟",
      "use_fa": "اگر جمله فعل be داشته باشد، سؤال و منفی با am/is/are ساخته می‌شود؛ اگر فعل معمولی باشد، با do/does.",
      "formulas": [
        {
          "label_fa": "با be",
          "text": "Are you Thai?\nIs she friendly?\nShe isn't very friendly."
        },
        {
          "label_fa": "با do",
          "text": "Do you like Thai food?\nDoes he work here?\nShe doesn't like coffee."
        },
        {
          "label_fa": "پاسخ کوتاه",
          "text": "Yes, I am. / Yes, I do.\nNo, she isn't. / No, he doesn't."
        }
      ],
      "examples": [
        {
          "en": "Are you Thai? — Yes, I am.",
          "fa": "تایلندی هستی؟ — بله."
        },
        {
          "en": "Do you like Thai food? — Yes, I do.",
          "fa": "غذای تایلندی دوست داری؟ — بله."
        },
        {
          "en": "She isn't very friendly.",
          "fa": "او خیلی خوش‌برخورد نیست."
        },
        {
          "en": "She doesn't like coffee.",
          "fa": "او قهوه دوست ندارد."
        }
      ],
      "notes_fa": "در پاسخ کوتاه، همان فعل کمکی تکرار می‌شود: Are you ...? → Yes, I am. / Do you ...? → Yes, I do."
    }
  ],
