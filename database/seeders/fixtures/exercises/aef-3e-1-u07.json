  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "simple past of be: was / were",
      "title_fa": "گذشتهٔ فعل be: was و were",
      "use_fa": "برای صحبت دربارهٔ گذشته: was برای I/he/she/it و were برای you/we/they. با born هم was/were می‌آید.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "I / He / She / It was ...\nYou / We / They were ...\nI was born in Canada."
        },
        {
          "label_fa": "منفی",
          "text": "wasn't / weren't\nShe wasn't in class yesterday."
        },
        {
          "label_fa": "سؤالی",
          "text": "Was he Dutch?\nWere you at home?\nYes, I was. / No, I wasn't."
        }
      ],
      "examples": [
        {
          "en": "Van Gogh was an artist.",
          "fa": "ون گوگ نقاش بود."
        },
        {
          "en": "The Beatles were famous in the 1960s.",
          "fa": "بیتلز در دههٔ ۱۹۶۰ مشهور بودند."
        },
        {
          "en": "Where were you last night?",
          "fa": "دیشب کجا بودی؟"
        },
        {
          "en": "She wasn't in class yesterday.",
          "fa": "او دیروز سر کلاس نبود."
        }
      ],
      "notes_fa": "was برای مفرد و were برای جمع و you. عبارات گذشته: yesterday، last night، in 2014."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "simple past: regular verbs",
      "title_fa": "گذشتهٔ ساده: افعال باقاعده",
      "use_fa": "برای کارهایی که در گذشته تمام شده‌اند. فعل ed می‌گیرد و برای همهٔ فاعل‌ها یک شکل است. سؤال و منفی با did/didn't و فعل پایه.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "subject + verb-ed\nI booked the flights.\nWe arrived at 10:00."
        },
        {
          "label_fa": "منفی",
          "text": "didn't + base verb\nThey didn't arrive until very late."
        },
        {
          "label_fa": "سؤالی",
          "text": "Did + subject + base verb?\nDid you watch the game?\nYes, I did. / No, I didn't."
        }
      ],
      "examples": [
        {
          "en": "I booked the flights yesterday.",
          "fa": "دیروز پروازها را رزرو کردم."
        },
        {
          "en": "We arrived at the airport at 10:00.",
          "fa": "ساعت ۱۰ به فرودگاه رسیدیم."
        },
        {
          "en": "She worked as a waiter last summer.",
          "fa": "او تابستان گذشته پیشخدمت بود."
        },
        {
          "en": "Did you watch the game last night?",
          "fa": "دیشب بازی را دیدی؟"
        }
      ],
      "notes_fa": "قواعد ed: watch→watched، arrive→arrived، study→studied، stop→stopped. بعد از did/didn't فعل پایه می‌آید."
    },
    {
      "key": "t3",
      "position": 3,
      "title_en": "simple past: irregular verbs",
      "title_fa": "گذشتهٔ ساده: افعال بی‌قاعده",
      "use_fa": "بسیاری از افعال پرکاربرد شکل گذشتهٔ خودشان را دارند: go→went، buy→bought، have→had. سؤال و منفی همچنان با did/didn't و فعل پایه است.",
      "formulas": [
        {
          "label_fa": "گذشته‌های رایج",
          "text": "buy → bought\ncome → came\nfeel → felt\nget → got\ngo → went\nhave → had\nknow → knew\nsay → said\ntake → took\nthink → thought\nwear → wore"
        },
        {
          "label_fa": "منفی/سؤالی",
          "text": "didn't go\nDid you go to a party?\nWho did you go with?"
        }
      ],
      "examples": [
        {
          "en": "I went to Iceland in December.",
          "fa": "دسامبر به ایسلند رفتم."
        },
        {
          "en": "She bought a new car.",
          "fa": "او ماشین نو خرید."
        },
        {
          "en": "We had a great time.",
          "fa": "خیلی خوش گذشت."
        },
        {
          "en": "I didn't go to New York.",
          "fa": "من به نیویورک نرفتم."
        }
      ],
      "notes_fa": "بعد از did/didn't شکل گذشته نمی‌آید: Did you go ...? (نه Did you went ...?) و didn't go (نه didn't went)."
    }
  ],
