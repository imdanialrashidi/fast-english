  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "simple past: regular and irregular",
      "title_fa": "گذشتهٔ ساده: باقاعده و بی‌قاعده",
      "use_fa": "مرور گذشته: was/were، could، افعال باقاعده با ed و بی‌قاعده با شکل خودشان. سؤال و منفی با did/didn't.",
      "formulas": [
        {
          "label_fa": "be و can",
          "text": "was / were\ncould / couldn't\nThey could hear a noise."
        },
        {
          "label_fa": "باقاعده",
          "text": "like → liked\nwant → wanted\ndidn't enjoy"
        },
        {
          "label_fa": "بی‌قاعده",
          "text": "go → went\nsee → saw\nsleep → slept"
        }
      ],
      "examples": [
        {
          "en": "Gordon was Jeremy's business partner.",
          "fa": "گوردون شریک تجاری جرمی بود."
        },
        {
          "en": "They could hear a strange noise.",
          "fa": "آن‌ها صدای عجیبی می‌شنیدند."
        },
        {
          "en": "She didn't enjoy the concert.",
          "fa": "او از کنسرت لذت نبرد."
        },
        {
          "en": "Did you watch the game last night?",
          "fa": "دیشب بازی را دیدی؟"
        }
      ],
      "notes_fa": "گذشتهٔ can می‌شود could و منفی‌اش couldn't. بعد از did/didn't فعل پایه می‌آید."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "there is / there are, some / any + plural nouns",
      "title_fa": "there is / there are و some / any",
      "use_fa": "می‌گوید چیزی وجود دارد یا ندارد. there is برای مفرد و there are برای جمع؛ some در مثبت و any در منفی و سؤال.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "There's a garage.\nThere are some pictures."
        },
        {
          "label_fa": "منفی",
          "text": "There isn't a pool.\nThere aren't any books."
        },
        {
          "label_fa": "سؤالی",
          "text": "Is there a bathroom?\nAre there any neighbors?"
        }
      ],
      "examples": [
        {
          "en": "There's a garage.",
          "fa": "یک گاراژ هست."
        },
        {
          "en": "There are two bedrooms upstairs.",
          "fa": "دو اتاق خواب طبقهٔ بالا هست."
        },
        {
          "en": "Is there a bathroom downstairs?",
          "fa": "طبقهٔ پایین حمام هست؟"
        },
        {
          "en": "There aren't any books.",
          "fa": "هیچ کتابی نیست."
        }
      ],
      "notes_fa": "some در جملهٔ مثبت جمع، any در منفی و سؤال: There are some pictures. / Are there any pictures?"
    },
    {
      "key": "t3",
      "position": 3,
      "title_en": "there was / there were",
      "title_fa": "there was / there were",
      "use_fa": "همان there is/are در گذشته: there was برای مفرد و there were برای جمع؛ منفی wasn't/weren't.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "There was a noise.\nThere were two men."
        },
        {
          "label_fa": "منفی",
          "text": "There wasn't a ghost.\nThere weren't any lights."
        },
        {
          "label_fa": "سؤالی",
          "text": "Was there a library?\nWere there any lights?"
        }
      ],
      "examples": [
