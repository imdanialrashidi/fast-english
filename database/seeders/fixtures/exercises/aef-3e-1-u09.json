  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "countable / uncountable nouns, a/an, some/any",
      "title_fa": "اسم شمارش‌پذیر و ناشمارش، a/an، some/any",
      "use_fa": "اسم‌های شمارش‌پذیر مفرد و جمع می‌شوند؛ ناشمارش‌ها جمع بسته نمی‌شوند. a/an با مفرد شمارش‌پذیر، some در مثبت و any در منفی و سؤال.",
      "formulas": [
        {
          "label_fa": "a/an",
          "text": "an apple / a tomato\na/an + singular countable noun"
        },
        {
          "label_fa": "some",
          "text": "some butter / some tomatoes\nمثبت با جمع و ناشمارش"
        },
        {
          "label_fa": "any",
          "text": "We don't need any tomatoes.\nDo we need any sugar?"
        }
      ],
      "examples": [
        {
          "en": "We need an apple.",
          "fa": "به یک سیب نیاز داریم."
        },
        {
          "en": "We need some butter.",
          "fa": "به کمی کره نیاز داریم."
        },
        {
          "en": "We don't need any tomatoes.",
          "fa": "به هیچ گوجه‌ای نیاز نداریم."
        },
        {
          "en": "Would you like some coffee?",
          "fa": "کمی قهوه میل داری؟"
        }
      ],
      "notes_fa": "اسم ناشمارش را جمع نمی‌بندیم: rice (نه two rices). در درخواست و تعارف بعضی وقت‌ها some می‌آید: Would you like some coffee?"
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "quantifiers",
      "title_fa": "کمیت‌ها: how much/many، a lot of، a little/few",
      "use_fa": "برای پرسیدن و گفتن مقدار. how much با ناشمارش و how many با جمع؛ a little با ناشمارش و a few با جمع.",
      "formulas": [
        {
          "label_fa": "پرسش مقدار",
          "text": "How much sugar do you eat?\nHow many cookies do you eat?"
        },
        {
          "label_fa": "مقدار",
          "text": "a lot of / lots of\na little / not much + uncountable\na few / not many + plural countable\nnot any = zero"
        }
      ],
      "examples": [
        {
          "en": "How much sugar do you eat?",
          "fa": "چقدر شکر می‌خوری؟"
        },
        {
          "en": "I eat a lot of sugar.",
          "fa": "من زیاد شکر می‌خورم."
        },
        {
          "en": "I eat a few cookies.",
          "fa": "کمی شیرینی می‌خورم."
        },
        {
          "en": "I don't drink much water.",
          "fa": "من آب زیادی نمی‌نوشم."
        }
      ],
      "notes_fa": "a little برای ناشمارش (a little sugar) و a few برای جمع (a few cookies). در جملهٔ منفی و سؤال معمولاً much/many می‌آید."
    },
    {
      "key": "t3",
      "position": 3,
      "title_en": "comparative adjectives",
      "title_fa": "صفت‌های مقایسه‌ای",
      "use_fa": "برای مقایسهٔ دو چیز: صفت کوتاه er می‌گیرد و صفت بلند با more می‌آید. بعد از مقایسه than می‌آید.",
      "formulas": [
        {
          "label_fa": "کوتاه",
          "text": "old → older\nbig → bigger\nhot → hotter\neasy → easier"
        },
        {
          "label_fa": "بلند",
          "text": "expensive → more expensive\ndifficult → more difficult\nstressed → more stressed"
        },
        {
          "label_fa": "بی‌قاعده",
          "text": "good → better\nbad → worse\nfar → farther / further"
        }
      ],
      "examples": [
        {
          "en": "A whale is louder than a lion.",
          "fa": "نهنگ از شیر پرصداتر است."
        },
        {
          "en": "Canada is bigger than the US.",
          "fa": "کانادا از آمریکا بزرگ‌تر است."
        },
        {
          "en": "K2 is more difficult to climb than Everest.",
          "fa": "صعود به K2 از اورست سخت‌تر است."
        },
        {
          "en": "My new job is better than my old one.",
          "fa": "شغل جدیدم از قبلی بهتر است."
        }
      ],
      "notes_fa": "good و bad بی‌قاعده‌اند: better و worse. صفت دو هجایی که به y ختم می‌شود y را به i تبدیل می‌کند: easy → easier."
    }
  ],
