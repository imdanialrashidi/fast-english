  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "adverbs (manner and modifiers)",
      "title_fa": "قیدهای حالت و تشدیدکننده‌ها",
      "use_fa": "قید حالت می‌گوید کاری چگونه انجام می‌شود و معمولاً بعد از فعل می‌آید. با very/really صفت یا قید را تقویت می‌کنیم.",
      "formulas": [
        {
          "label_fa": "ساخت قید",
          "text": "adjective + -ly\nslow → slowly\ncareful → carefully\neasy → easily"
        },
        {
          "label_fa": "بی‌قاعده",
          "text": "good → well\nfast → fast\nhard → hard"
        },
        {
          "label_fa": "جای قید",
          "text": "after the verb\nI speak English well.\nShe drives carefully."
        }
      ],
      "examples": [
        {
          "en": "She wants to live independently.",
          "fa": "او می‌خواهد مستقل زندگی کند."
        },
        {
          "en": "He speaks English well.",
          "fa": "او انگلیسی را خوب صحبت می‌کند."
        },
        {
          "en": "She drives incredibly fast.",
          "fa": "او باورنکردنی سریع رانندگی می‌کند."
        },
        {
          "en": "It isn't very expensive.",
          "fa": "خیلی گران نیست."
        }
      ],
      "notes_fa": "صفت اسم را توصیف می‌کند (a careful driver) و قید فعل را (drive carefully). good قیدش well است، نه goodly."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "verb + infinitive",
      "title_fa": "فعل + مصدر با to",
      "use_fa": "بعد از برخی فعل‌ها مثل want، need، decide، learn و would like فعل به شکل to + پایه می‌آید.",
      "formulas": [
        {
          "label_fa": "الگو",
          "text": "want / need / decide / learn / plan / promise / try + to + base verb\nI want to travel.\nShe decided to go."
        },
        {
          "label_fa": "would like",
          "text": "would like + to + base verb\nI'd like to dance.\nWould you like to go?"
        }
      ],
      "examples": [
        {
          "en": "I want to travel for six months.",
          "fa": "می‌خواهم شش ماه سفر کنم."
        },
        {
          "en": "She decided to go to Australia.",
          "fa": "او تصمیم گرفت به استرالیا برود."
        },
        {
          "en": "You need to practice every day.",
          "fa": "باید هر روز تمرین کنی."
        },
        {
          "en": "Would you like to go to Africa?",
          "fa": "دوست داری به آفریقا بروی؟"
        }
      ],
      "notes_fa": "would like یعنی «می‌خواهم» و مثل want با to می‌آید؛ ولی like به‌تنهایی با ing: I like dancing."
    },
    {
      "key": "t3",
      "position": 3,
      "title_en": "definite article",
      "title_fa": "حرف تعریف the",
      "use_fa": "the وقتی است که شنونده می‌داند دربارهٔ چه چیزی حرف می‌زنیم. برای اشارهٔ کلی و بعضی عبارت‌های ثابت، مقاله نمی‌آید.",
      "formulas": [
        {
          "label_fa": "با the",
          "text": "Close the window.\nthe best restaurant\nthe internet"
        },
        {
          "label_fa": "بدون مقاله",
          "text": "Men are usually more interested in sports.\nWhat time did you have breakfast?\nJim goes to school by bus."
        },
        {
          "label_fa": "a/an و the",
          "text": "Let's have a pizza. The pizzas are very good here."
        }
      ],
      "examples": [
        {
          "en": "Can you close the window, please?",
          "fa": "می‌شود پنجره را ببندی؟"
        },
        {
          "en": "It's the best restaurant I know.",
          "fa": "بهترین رستورانی است که می‌شناسم."
        },
        {
          "en": "What time did you have breakfast?",
          "fa": "چه ساعتی صبحانه خوردی؟"
        },
        {
          "en": "Can you check their address on the internet?",
          "fa": "می‌شود آدرسشان را در اینترنت چک کنی؟"
        }
      ],
      "notes_fa": "برای چیز مشخص the می‌آید؛ برای اشارهٔ کلی جمع، مقاله نمی‌آید: Men are interested in sports. عبارت‌هایی مثل have breakfast، go to school بدون مقاله‌اند."
    }
  ],
