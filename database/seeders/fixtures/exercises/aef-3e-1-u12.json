  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "present perfect",
      "title_fa": "حال کامل",
      "use_fa": "برای کارهایی در گذشته که زمانشان را نمی‌گوییم: تجربه‌های زندگی یا کارهای تازه. با have/has + قسمت سوم فعل ساخته می‌شود.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "I / You / We / They have + past participle\nHe / She / It has + past participle\nI've seen that movie."
        },
        {
          "label_fa": "منفی",
          "text": "haven't / hasn't + past participle\nShe hasn't read any books in English."
        },
        {
          "label_fa": "سؤالی",
          "text": "Have you ...?\nHas he ...?\nHave you ever been to Japan?"
        }
      ],
      "examples": [
        {
          "en": "Have you seen the new movie?",
          "fa": "فیلم جدید را دیده‌ای؟"
        },
        {
          "en": "I've never worked in an office.",
          "fa": "من هرگز در دفتر کار نکرده‌ام."
        },
        {
          "en": "Your parents have arrived.",
          "fa": "والدینت رسیده‌اند."
        },
        {
          "en": "I've seen it ten times.",
          "fa": "من آن را ده بار دیده‌ام."
        }
      ],
      "notes_fa": "past participle فعل‌های باقاعده همان ed است (worked) ولی بی‌قاعده‌ها شکل سوم دارند: see→seen، eat→eaten، write→written."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "present perfect or simple past?",
      "title_fa": "حال کامل یا گذشتهٔ ساده؟",
      "use_fa": "حال کامل برای تجربه یا خبر بدون زمان؛ گذشتهٔ ساده برای جزئیات و وقتی زمان را می‌گوییم. با when و زمان گذشته همیشه گذشتهٔ ساده.",
      "formulas": [
        {
          "label_fa": "حال کامل",
          "text": "Have you been to that restaurant?\nYes, I have.\n(بدون زمان)"
        },
        {
          "label_fa": "گذشته",
          "text": "When did you go there?\nI went last weekend.\n(با زمان مشخص)"
        }
      ],
      "examples": [
        {
          "en": "Have you been to that new restaurant?",
          "fa": "به آن رستوران جدید رفته‌ای؟"
        },
        {
          "en": "When did you go there? — Last weekend.",
          "fa": "کِی رفتی؟ — آخر هفتهٔ گذشته."
        },
        {
          "en": "Who did you go with?",
          "fa": "با چه کسی رفتی؟"
        },
        {
          "en": "I saw it last week.",
          "fa": "هفتهٔ گذشته آن را دیدم."
        }
      ],
      "notes_fa": "با when و with last week/yesterday گذشتهٔ ساده می‌آید: When did you see it? (نه When have you seen it?)"
    },
    {
      "key": "t3",
      "position": 3,
      "title_en": "been or gone?",
      "title_fa": "been یا gone؟",
      "use_fa": "been یعنی جایی رفته و برگشته؛ gone یعنی رفته و هنوز آنجاست.",
      "formulas": [
        {
          "label_fa": "been",
          "text": "has/have been to a place = visited and came back\nI've been to Tokyo three times."
        },
        {
          "label_fa": "gone",
          "text": "has/have gone to a place = is there now\nShe's gone to Japan."
        }
      ],
      "examples": [
        {
          "en": "Have you ever been to Japan?",
          "fa": "تا حالا به ژاپن رفته‌ای؟"
        },
        {
          "en": "My sister has gone to Japan to study.",
          "fa": "خواهرم برای درس به ژاپن رفته است."
        },
        {
          "en": "I've been to Tokyo three times.",
          "fa": "سه بار به توکیو رفته‌ام."
        },
        {
          "en": "She isn't here. She's gone to the store.",
          "fa": "او اینجا نیست. به فروشگاه رفته است."
        }
      ],
      "notes_fa": "been با بازگشت همراه است و gone با بودن در مقصد: Nick has been to Paris (برگشته) / Nick has gone to Paris (الان آنجاست)."
    }
  ],
