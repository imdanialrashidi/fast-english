  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "word order in questions",
      "title_fa": "ترتیب کلمات در سؤال",
      "use_fa": "در سؤال با be و can جای فاعل و فعل عوض می‌شود؛ در سؤال با فعل معمولی do/does/did قبل از فاعل و فعل پایه بعد از آن می‌آید.",
      "formulas": [
        {
          "label_fa": "با be/can",
          "text": "Are you hungry?\nCan I sit here?\nWhere were you born?"
        },
        {
          "label_fa": "با do/does/did",
          "text": "Do you live with your parents?\nDid you go out last night?\nWhere did you go?"
        }
      ],
      "examples": [
        {
          "en": "Are you hungry?",
          "fa": "گرسنه‌ای؟"
        },
        {
          "en": "Can I sit here?",
          "fa": "می‌توانم اینجا بنشینم؟"
        },
        {
          "en": "Where were you born?",
          "fa": "کجا به دنیا آمدی؟"
        },
        {
          "en": "Where did you go?",
          "fa": "کجا رفتی؟"
        }
      ],
      "notes_fa": "بعد از did فعل پایه می‌آید: Where did you go? (نه did you went). با be از do استفاده نمی‌کنیم."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "simple present",
      "title_fa": "حال ساده",
      "use_fa": "برای کارهای روزمره و چیزهایی که همیشه درست‌اند. با he/she/it فعل s می‌گیرد و منفی/سؤالی با do/does ساخته می‌شود.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "I / You / We / They work\nHe / She / It works\nMy brother works in the city."
        },
        {
          "label_fa": "منفی",
          "text": "don't / doesn't + base verb\nMy parents don't live near here."
        },
        {
          "label_fa": "قید تکرار",
          "text": "before the main verb, after be\nWe often go out.\nI'm never sick."
        }
      ],
      "examples": [
        {
          "en": "My brother works in the city.",
          "fa": "برادرم در شهر کار می‌کند."
        },
        {
          "en": "I usually work at home.",
          "fa": "من معمولاً خانه کار می‌کنم."
        },
        {
          "en": "It doesn't often rain here.",
          "fa": "اینجا معمولاً باران نمی‌بارد."
        },
        {
          "en": "She gets up early every day.",
          "fa": "او هر روز زود بیدار می‌شود."
        }
      ],
      "notes_fa": "قید تکرار قبل از فعل اصلی و بعد از be می‌آید: She's never sick. با never فعل مثبت است."
    },
    {
      "key": "t3",
      "position": 3,
      "title_en": "present continuous: be + verb + -ing",
      "title_fa": "حال استمراری و مقایسه با حال ساده",
      "use_fa": "برای کاری که همین حالا یا همین روزها در جریان است و برای توصیف تصویر. حال ساده برای عادت است.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "I'm working.\nShe's working.\nThey're working."
        },
        {
          "label_fa": "منفی",
          "text": "I'm not working.\nHe isn't working.\nThey aren't working."
        },
        {
          "label_fa": "سؤالی",
          "text": "Are you working?\nWhat are you doing?"
        }
      ],
      "examples": [
        {
          "en": "What are you doing? — I'm sending a message.",
          "fa": "چه کار می‌کنی؟ — دارم پیام می‌فرستم."
        },
        {
          "en": "My brother is taking a two-month vacation.",
          "fa": "برادرم دو ماه مرخصی می‌گیرد."
        },
        {
          "en": "In this picture the woman is standing near a table.",
          "fa": "در این تصویر زن کنار میزی ایستاده است."
        },
        {
          "en": "What do you do? — I work for an IT company.",
          "fa": "چه کار می‌کنی؟ — در یک شرکت IT کار می‌کنم."
        }
      ],
      "notes_fa": "What do you do? یعنی «شغلت چیست؟» ولی What are you doing? یعنی «الان چه کار می‌کنی؟»"
    }
  ],
