  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "simple past: regular and irregular verbs",
      "title_fa": "گذشتهٔ ساده: افعال باقاعده و بی‌قاعده",
      "use_fa": "برای کارهای تمام‌شده در گذشته. باقاعده‌ها ed می‌گیرند، بی‌قاعده‌ها شکل خودشان را دارند و سؤال/منفی با did/didn't و فعل پایه ساخته می‌شود.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "stay → stayed\ngo → went\nsee → saw"
        },
        {
          "label_fa": "منفی",
          "text": "didn't + base verb\nHe didn't stay with friends."
        },
        {
          "label_fa": "سؤالی",
          "text": "Did + subject + base verb?\nDid you stay?\nWhere did you stay?"
        }
      ],
      "examples": [
        {
          "en": "We stayed at a hotel last summer.",
          "fa": "تابستان گذشته در هتل ماندیم."
        },
        {
          "en": "I went to Turkey twice last year.",
          "fa": "سال گذشته دو بار به ترکیه رفتم."
        },
        {
          "en": "Where did you stay?",
          "fa": "کجا ماندی؟"
        },
        {
          "en": "She didn't go to Thailand.",
          "fa": "او به تایلند نرفت."
        }
      ],
      "notes_fa": "بعد از did/didn't فعل پایه می‌آید: Did you go? (نه Did you went?) قواعد ed: stay→stayed، like→liked، study→studied، stop→stopped."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "past continuous: was / were + verb + -ing",
      "title_fa": "گذشتهٔ استمراری",
      "use_fa": "برای کاری که در یک لحظهٔ مشخص در گذشته در جریان بود. با was/were + فعل ing ساخته می‌شود.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "I / He / She / It was + verb-ing\nYou / We / They were + verb-ing"
        },
        {
          "label_fa": "منفی",
          "text": "wasn't / weren't + verb-ing\nIt wasn't raining."
        },
        {
          "label_fa": "سؤالی",
          "text": "Was he working?\nWhat were you doing?\nYes, I was. / No, I wasn't."
        }
      ],
      "examples": [
        {
          "en": "At 8:45 last Saturday I was walking in the park.",
          "fa": "شنبهٔ گذشته ساعت ۸:۴۵ در پارک قدم می‌زدم."
        },
        {
          "en": "The birds were singing.",
          "fa": "پرنده‌ها آواز می‌خواندند."
        },
        {
          "en": "What were you doing at 11 o'clock?",
          "fa": "ساعت ۱۱ چه کار می‌کردی؟"
        },
        {
          "en": "It wasn't raining.",
          "fa": "باران نمی‌بارید."
        }
      ],
      "notes_fa": "گذشتهٔ استمراری برای لحظهٔ مشخص در گذشته است، نه عادت. با at 8:45، at that moment و when می‌آید."
    },
    {
      "key": "t3",
      "position": 3,
      "title_en": "simple past or past continuous? time sequencers",
      "title_fa": "گذشتهٔ ساده یا استمراری؟ ترتیب زمان",
      "use_fa": "گذشتهٔ استمراری کار طولانی پس‌زمینه است و گذشتهٔ ساده کار کوتاه که آن را قطع می‌کند. ترتیب رویدادها با then، after that، later و the next day بیان می‌شود.",
      "formulas": [
        {
          "label_fa": "ترکیب",
          "text": "past continuous + when + simple past\nWe were walking when he took a photo."
        },
        {
          "label_fa": "ترتیب",
          "text": "On their first date ...\nAfter that ...\nTwo minutes later ...\nThe next day ..."
        },
        {
          "label_fa": "ربط",
          "text": "because = reason\nso = result\nbut / although = contrast"
        }
      ],
      "examples": [
        {
          "en": "We were walking in the gardens when he took a photo.",
          "fa": "در باغ قدم می‌زدیم که او عکس گرفت."
        },
        {
          "en": "My sister arrived when I was having lunch.",
          "fa": "خواهرم وقتی ناهار می‌خوردم رسید."
        },
        {
          "en": "Two minutes later my phone rang.",
          "fa": "دو دقیقه بعد تلفنم زنگ خورد."
        },
        {
          "en": "She was in a hurry, so she was driving fast.",
          "fa": "او عجله داشت، برای همین سریع رانندگی می‌کرد."
        }
      ],
      "notes_fa": "then و after that ترتیب را نشان می‌دهند (نه after). because دلیل و so نتیجه است؛ but و although تضاد."
    }
  ],
