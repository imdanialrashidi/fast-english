  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "be going to (plans and predictions)",
      "title_fa": "be going to برای برنامه و پیش‌بینی",
      "use_fa": "برای برنامه‌های آینده و پیش‌بینی چیزی که می‌بینیم یا می‌دانیم اتفاق می‌افتد. با am/is/are + going to + فعل پایه.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "I'm going to give a talk.\nHe's going to meet me.\nIt's going to rain."
        },
        {
          "label_fa": "منفی",
          "text": "I'm not going to ...\nShe isn't going to come."
        },
        {
          "label_fa": "سؤالی",
          "text": "Are you going to give a talk?\nIs he going to come?"
        }
      ],
      "examples": [
        {
          "en": "I'm going to give a talk at a conference.",
          "fa": "قرار است در یک کنفرانس سخنرانی کنم."
        },
        {
          "en": "They're going to lose tomorrow.",
          "fa": "آن‌ها فردا می‌بازند."
        },
        {
          "en": "It's going to rain tonight.",
          "fa": "امشب باران می‌آید."
        },
        {
          "en": "Look at that car! It's going to crash.",
          "fa": "آن ماشین را ببین! می‌خواهد تصادف کند."
        }
      ],
      "notes_fa": "بعد از going to فعل پایه می‌آید: going to give (نه going to giving)."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "present continuous (future arrangements)",
      "title_fa": "حال استمراری برای قرارهای آینده",
      "use_fa": "برای قرار و برنامهٔ قطعی در آینده (زمان و مکان مشخص). با فعل ing و عبارت‌های tonight، tomorrow، this weekend.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "I'm seeing an old friend tonight.\nShe's arriving at lunchtime."
        },
        {
          "label_fa": "منفی",
          "text": "She isn't leaving until Friday."
        },
        {
          "label_fa": "سؤالی",
          "text": "What are you doing this evening?\nIs he meeting us?"
        }
      ],
      "examples": [
        {
          "en": "I'm seeing an old friend tonight.",
          "fa": "امشب دوست قدیمی‌ام را می‌بینم."
        },
        {
          "en": "She's arriving at lunchtime.",
          "fa": "او موقع ناهار می‌رسد."
        },
        {
          "en": "They aren't coming to the party tomorrow.",
          "fa": "آن‌ها فردا به مهمانی نمی‌آیند."
        },
        {
          "en": "I'm leaving on Monday.",
          "fa": "دوشنبه می‌روم."
        }
      ],
      "notes_fa": "برای قرار آینده از حال استمراری استفاده می‌کنیم، نه حال ساده. با افعال travel مثل go/come/leave/arrive رایج است."
    },
    {
      "key": "t3",
      "position": 3,
      "title_en": "defining relative clauses with who, that, where",
      "title_fa": "جمله‌های وصفی با who، that و where",
      "use_fa": "برای توضیح اینکه یک شخص، چیز یا مکان چیست یا چه کار می‌کند. who برای شخص، that برای چیز و where برای مکان.",
      "formulas": [
        {
          "label_fa": "شخص",
          "text": "A chef is a person who cooks food."
        },
        {
          "label_fa": "چیز",
          "text": "A clock is something that tells the time."
        },
        {
          "label_fa": "مکان",
          "text": "A post office is a place where you can buy stamps."
        }
      ],
      "examples": [
        {
          "en": "That's the woman who won the lottery.",
          "fa": "آن زنی است که در لاتاری برنده شد."
        },
        {
          "en": "Is that the book that won an important prize?",
          "fa": "آن کتابی است که جایزهٔ مهمی گرفت؟"
        },
        {
          "en": "That's the restaurant where I had dinner.",
          "fa": "آن رستورانی است که شام خوردم."
        },
        {
          "en": "A post office is a place where you can buy stamps.",
          "fa": "پست‌خانه جایی است که می‌توانی تمبر بخری."
        }
      ],
      "notes_fa": "بعد از where جمله باید فاعل داشته باشد: where you can buy stamps. می‌توان به‌جای who برای شخص هم that آورد."
    }
  ],
