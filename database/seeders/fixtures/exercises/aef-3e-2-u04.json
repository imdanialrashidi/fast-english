  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "present perfect: yet, already",
      "title_fa": "حال کامل با yet و already",
      "use_fa": "برای کارهای تازه و خبرهای نزدیک که زمانشان را نمی‌گوییم. yet در سؤال و منفی و already در مثبت می‌آید.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "have/has + past participle\nI've cleaned the refrigerator."
        },
        {
          "label_fa": "منفی",
          "text": "haven't / hasn't + past participle\nHe hasn't done the dishes."
        },
        {
          "label_fa": "yet/already",
          "text": "Have you finished yet?\nI've already seen it three times."
        }
      ],
      "examples": [
        {
          "en": "I've cleaned the refrigerator!",
          "fa": "یخچال را تمیز کرده‌ام!"
        },
        {
          "en": "He hasn't done the dishes.",
          "fa": "او ظرف‌ها را نشسته است."
        },
        {
          "en": "Have you turned off your phone?",
          "fa": "تلفنت را خاموش کرده‌ای؟"
        },
        {
          "en": "I've already seen it three times.",
          "fa": "سه بار دیده‌ام."
        }
      ],
      "notes_fa": "yet در پایان جمله می‌آید (Have you finished yet?) و already قبل از فعل اصلی (I've already seen it)."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "present perfect or simple past? (experiences)",
      "title_fa": "حال کامل یا گذشتهٔ ساده؟ (تجربه‌ها)",
      "use_fa": "حال کامل برای تجربه بدون زمان؛ گذشتهٔ ساده برای جزئیات و زمان مشخص. مکالمه معمولاً با حال کامل شروع و با گذشته ادامه می‌یابد.",
      "formulas": [
        {
          "label_fa": "حال کامل",
          "text": "Have you ever been to Mexico?\nI've never met her."
        },
        {
          "label_fa": "گذشته",
          "text": "When did you go there?\nI went last year."
        }
      ],
      "examples": [
        {
          "en": "She's been to New York three times.",
          "fa": "او سه بار به نیویورک رفته است."
        },
        {
          "en": "Have you ever been to Ikea?",
          "fa": "تا حالا به ایکیا رفته‌ای؟"
        },
        {
          "en": "When did you go there? — Last year.",
          "fa": "کِی رفتی؟ — سال گذشته."
        },
        {
          "en": "Mike has gone to Paris. He's there now.",
          "fa": "مایک به پاریس رفته و الان آنجاست."
        }
      ],
      "notes_fa": "been یعنی رفته و برگشته؛ gone یعنی رفته و هنوز آنجاست. با when و last year گذشتهٔ ساده می‌آید."
    },
    {
      "key": "t3",
      "position": 3,
      "title_en": "something, anything, nothing, etc.",
      "title_fa": "something، anything، nothing و مشابه‌ها",
      "use_fa": "برای چیزها، افراد و مکان‌های نامشخص. some- در جملهٔ مثبت، any- در سؤال و منفی، و no- به معنی هیچ.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "Somebody has taken my pen.\nI bought something for dinner.\nLet's go somewhere."
        },
        {
          "label_fa": "سؤال/منفی",
          "text": "Did anybody call?\nI didn't do anything.\nIs there anywhere to park?"
        },
        {
          "label_fa": "هیچ",
          "text": "Nobody called.\nThere's nothing in the refrigerator."
        }
      ],
      "examples": [
        {
          "en": "Somebody has taken my pen!",
          "fa": "یک نفر خودکارم را برداشته!"
        },
        {
          "en": "I didn't speak to anybody all weekend.",
          "fa": "تمام آخر هفته با هیچ‌کس حرف نزدم."
        },
        {
          "en": "Is there anything in the refrigerator?",
          "fa": "چیزی در یخچال هست؟"
        },
        {
          "en": "There's nowhere to park.",
          "fa": "هیچ‌جا برای پارک نیست."
        }
      ],
      "notes_fa": "با nobody/nothing فعل مثبت است: Nobody called. (نه didn't call). any- در جملهٔ مثبت هم می‌آید به معنی «هر»."
    }
  ],
