  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "comparatives",
      "title_fa": "مقایسه‌ای‌ها",
      "use_fa": "برای مقایسهٔ دو چیز یا دو کار: صفت/قید کوتاه er می‌گیرد، بلند با more می‌آید، و می‌توان از less و as...as هم استفاده کرد.",
      "formulas": [
        {
          "label_fa": "صفت",
          "text": "busy → busier\nhot → hotter\nrelaxed → more relaxed\ngood → better\nbad → worse"
        },
        {
          "label_fa": "قید",
          "text": "quickly → more quickly\nfast → faster\nwell → better"
        },
        {
          "label_fa": "کمتر/مساوی",
          "text": "less + adjective/adverb\n(not) as + adjective/adverb + as"
        }
      ],
      "examples": [
        {
          "en": "I'm busier than I was five years ago.",
          "fa": "من از پنج سال پیش شلوغ‌ترم."
        },
        {
          "en": "People are more impatient today than in the past.",
          "fa": "مردم امروز بی‌حوصله‌تر از گذشته‌اند."
        },
        {
          "en": "The service isn't as good as it was.",
          "fa": "سرویس به خوبی قبل نیست."
        },
        {
          "en": "People walk more quickly than in the past.",
          "fa": "مردم سریع‌تر از گذشته راه می‌روند."
        }
      ],
      "notes_fa": "بعد از مقایسه than می‌آید و بعد از as...as هم as. با ضمیر می‌توان گفت than me یا than I am."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "superlatives",
      "title_fa": "صفت‌های عالی",
      "use_fa": "برای گفتن بهترین/بزرگ‌ترین در یک گروه. با the + صفت عالی و برای مکان‌ها in می‌آید. با ever و حال کامل رایج است.",
      "formulas": [
        {
          "label_fa": "کوتاه",
          "text": "cold → the coldest\nthin → the thinnest\nhealthy → the healthiest"
        },
        {
          "label_fa": "بلند",
          "text": "beautiful → the most beautiful\nleast + adjective = the least expensive"
        },
        {
          "label_fa": "بی‌قاعده",
          "text": "good → the best\nbad → the worst\nfar → the farthest"
        }
      ],
      "examples": [
        {
          "en": "Tokyo is the cleanest city in the world.",
          "fa": "توکیو تمیزترین شهر جهان است."
        },
        {
          "en": "Mexico is one of the most popular destinations.",
          "fa": "مکزیک یکی از محبوب‌ترین مقصدهاست."
        },
        {
          "en": "It's the most beautiful city I've ever been to.",
          "fa": "زیباترین شهری است که تا حالا دیده‌ام."
        },
        {
          "en": "Camping is the least expensive way.",
          "fa": "کمپینگ کم‌هزینه‌ترین راه است."
        }
      ],
      "notes_fa": "بعد از صفت عالی برای مکان in می‌آید: the oldest in the class. the least + صفت یعنی کمترین."
    },
    {
      "key": "t3",
      "position": 3,
      "title_en": "quantifiers: too much, too many, too, enough",
      "title_fa": "کمیت‌ها: too much، too many، too و enough",
      "use_fa": "too much/too many یعنی بیشتر از حد خوب؛ too با صفت؛ enough یعنی به‌اندازهٔ کافی.",
      "formulas": [
        {
          "label_fa": "too",
          "text": "too much + uncountable\ntoo many + countable\ntoo + adjective"
        },
        {
          "label_fa": "enough",
          "text": "enough + noun\nadjective + enough\nverb + enough"
        }
      ],
      "examples": [
        {
          "en": "I have too much work.",
          "fa": "کار زیادی دارم (بیش از حد)."
        },
        {
          "en": "I eat too many cookies.",
          "fa": "شیرینی زیادی می‌خورم."
        },
        {
          "en": "I'm too tired.",
          "fa": "خیلی خسته‌ام."
        },
        {
          "en": "Do you eat enough vegetables?",
          "fa": "به‌اندازهٔ کافی سبزی می‌خوری؟"
        }
      ],
      "notes_fa": "too much با ناشمارش (work) و too many با جمع (cookies). enough بعد از صفت می‌آید: big enough."
    }
  ],
