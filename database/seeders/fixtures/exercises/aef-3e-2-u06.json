  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "will / won't (predictions)",
      "title_fa": "will و won't برای پیش‌بینی",
      "use_fa": "برای گفتن چیزی که فکر می‌کنیم یا حدس می‌زنیم در آینده اتفاق می‌افتد. با will/won't + فعل پایه.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "subject + will + base verb\nShe'll be late.\nI think it will rain."
        },
        {
          "label_fa": "منفی",
          "text": "won't + base verb\nWe won't understand anything."
        },
        {
          "label_fa": "سؤالی",
          "text": "Will you be late?\nYes, I will. / No, I won't."
        }
      ],
      "examples": [
        {
          "en": "She'll be late.",
          "fa": "او دیر می‌رسد."
        },
        {
          "en": "We won't understand anything.",
          "fa": "ما چیزی نمی‌فهمیم."
        },
        {
          "en": "I think it will rain tomorrow.",
          "fa": "فکر می‌کنم فردا باران می‌آید."
        },
        {
          "en": "I'm sure you'll like it.",
          "fa": "مطمئنم خوشت می‌آید."
        }
      ],
      "notes_fa": "با I think / I'm sure می‌توان will آورد؛ با I don't think هم will می‌آید: I don't think he'll pass."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "will / won't (other uses)",
      "title_fa": "will و won't برای تصمیم، پیشنهاد و قول",
      "use_fa": "will برای تصمیم لحظه‌ای، پیشنهاد کمک و قول دادن؛ shall در سؤال با I/we برای پیشنهاد.",
      "formulas": [
        {
          "label_fa": "پیشنهاد/قول",
          "text": "I'll help you.\nI won't tell anybody."
        },
        {
          "label_fa": "تصمیم",
          "text": "I think I'll go home early.\nI won't stay for dinner."
        },
        {
          "label_fa": "پیشنهاد با shall",
          "text": "Shall we go for a walk?"
        }
      ],
      "examples": [
        {
          "en": "I'll help you with those bags.",
          "fa": "با آن کیف‌ها کمکت می‌کنم."
        },
        {
          "en": "I won't tell anybody.",
          "fa": "به هیچ‌کس نمی‌گویم."
        },
        {
          "en": "I think I'll go home early.",
          "fa": "فکر می‌کنم زودتر خانه بروم."
        },
        {
          "en": "Shall we go for a walk?",
          "fa": "برویم قدم بزنیم؟"
        }
      ],
      "notes_fa": "برای تصمیم لحظه‌ای از will استفاده می‌کنیم، نه حال ساده: I'll open the door (نه I open)."
    },
    {
      "key": "t3",
      "position": 3,
      "title_en": "review of verb forms: present, past, and future",
      "title_fa": "مرور زمان‌ها: حال، گذشته و آینده",
      "use_fa": "مرور کاربرد زمان‌ها: عادت (حال ساده)، همین حالا (استمراری)، گذشتهٔ ساده/استمراری، برنامه و پیش‌بینی آینده.",
      "formulas": [
        {
          "label_fa": "حال",
          "text": "I live downtown. (always)\nHe's looking for a job. (now)"
        },
        {
          "label_fa": "گذشته",
          "text": "We saw a movie last night.\nHe was working at 7:00."
        },
        {
          "label_fa": "آینده",
          "text": "I'm leaving tomorrow. (arrangement)\nI'm going to see Tom. (plan)\nIt's going to snow. (prediction)"
        }
      ],
      "examples": [
        {
          "en": "I live downtown.",
          "fa": "من مرکز شهر زندگی می‌کنم."
        },
        {
          "en": "He's looking for a new job.",
          "fa": "او دنبال کار جدید است."
        },
        {
          "en": "We saw a good movie last night.",
          "fa": "دیشب فیلم خوبی دیدیم."
        },
        {
          "en": "Look! It's going to snow.",
          "fa": "نگاه کن! دارد برف می‌آید."
        }
      ],
      "notes_fa": "برای قرار آینده حال استمراری (I'm leaving tomorrow) و برای برنامه be going to؛ برای پیش‌بینی از روی شواهد هم be going to."
    }
  ],
