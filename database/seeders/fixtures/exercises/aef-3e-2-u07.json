  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "uses of the infinitive",
      "title_fa": "کاربردهای مصدر با to",
      "use_fa": "مصدر با to بعد از برخی فعل‌ها و صفت‌ها، بعد از کلمهٔ پرسشی و برای گفتن دلیل می‌آید. منفی‌اش not to است.",
      "formulas": [
        {
          "label_fa": "بعد از فعل/صفت",
          "text": "need to be\ntry not to talk\nIt's important not to be late."
        },
        {
          "label_fa": "بعد از کلمهٔ پرسشی",
          "text": "I don't know where to go."
        },
        {
          "label_fa": "دلیل",
          "text": "I came here to learn English."
        }
      ],
      "examples": [
        {
          "en": "You need to be on time.",
          "fa": "باید سر وقت باشی."
        },
        {
          "en": "Try not to talk too much.",
          "fa": "سعی کن زیاد حرف نزنی."
        },
        {
          "en": "It'll be nice to meet new people.",
          "fa": "آشنایی با آدم‌های جدید خوب است."
        },
        {
          "en": "I came to this school to learn English.",
          "fa": "به این مدرسه آمدم تا انگلیسی یاد بگیرم."
        }
      ],
      "notes_fa": "برای دلیل از to + فعل پایه استفاده می‌کنیم، نه for: to learn English (نه for learn)."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "uses of the gerund (verb + -ing)",
      "title_fa": "کاربردهای اسم مصدر (فعل + ing)",
      "use_fa": "فعل ing‌دار می‌تواند نقش اسم را بازی کند: فاعل، مفعول، بعد از برخی فعل‌ها و بعد از حرف اضافه.",
      "formulas": [
        {
          "label_fa": "فاعل/مفعول",
          "text": "Eating outside makes me feel good.\nHappiness is getting up late."
        },
        {
          "label_fa": "بعد از فعل",
          "text": "I love having breakfast in bed.\nI hate not getting to the airport early."
        },
        {
          "label_fa": "بعد از حرف اضافه",
          "text": "I'm thinking of buying a car.\nHe left without saying goodbye."
        }
      ],
      "examples": [
        {
          "en": "Eating outside in the summer makes me feel good.",
          "fa": "تابستان بیرون غذا خوردن حالم را خوب می‌کند."
        },
        {
          "en": "Happiness is getting up late.",
          "fa": "خوشبختی یعنی دیر بیدار شدن."
        },
        {
          "en": "I'm thinking of buying a new car.",
          "fa": "به خرید ماشین نو فکر می‌کنم."
        },
        {
          "en": "Jim left without saying goodbye.",
          "fa": "جیم بدون خداحافظی رفت."
        }
      ],
      "notes_fa": "بعد از حرف اضافه همیشه ing می‌آید: without saying (نه without say). منفی‌اش not + ing است: not getting."
    },
    {
      "key": "t3",
      "position": 3,
      "title_en": "have to, don't have to, must, must not, can't",
      "title_fa": "have to، don't have to، must، must not و can't",
      "use_fa": "have to برای اجبار و قانون؛ don't have to یعنی لازم نیست؛ must/must not و can't برای اجبار و ممنوعیت.",
      "formulas": [
        {
          "label_fa": "اجبار",
          "text": "have to / has to + base verb\nI have to speak English at work."
        },
        {
          "label_fa": "لازم نبودن",
          "text": "don't / doesn't have to\nWe don't have to wear a uniform."
        },
        {
          "label_fa": "ممنوعیت",
          "text": "must not / can't + base verb\nYou must not smoke here."
        }
      ],
      "examples": [
        {
          "en": "I have to speak English at work.",
          "fa": "باید سر کار انگلیسی صحبت کنم."
        },
        {
          "en": "She has to get up at seven.",
          "fa": "او باید ساعت هفت بیدار شود."
        },
        {
          "en": "We don't have to wear a uniform.",
          "fa": "لازم نیست لباس فرم بپوشیم."
        },
        {
          "en": "You must not smoke here.",
          "fa": "اینجا نباید سیگار بکشی."
        }
      ],
      "notes_fa": "don't have to با must not فرق دارد: اولی «لازم نیست» و دومی «ممنوع است». سؤال و منفی have to با do/does ساخته می‌شود."
    }
  ],
