  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "should / shouldn't",
      "title_fa": "should و shouldn't",
      "use_fa": "برای نصیحت و گفتن کار درست. should برای همهٔ فاعل‌ها یک شکل است و بعد از آن فعل پایه می‌آید.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "subject + should + base verb\nYou should leave your boyfriend."
        },
        {
          "label_fa": "منفی",
          "text": "subject + shouldn't + base verb\nShe shouldn't work so hard."
        },
        {
          "label_fa": "نصیحت",
          "text": "I think you should ...\nI don't think you should ..."
        }
      ],
      "examples": [
        {
          "en": "You should leave your boyfriend.",
          "fa": "باید دوست‌پسرت را ترک کنی."
        },
        {
          "en": "She shouldn't work so hard.",
          "fa": "او نباید این‌قدر سخت کار کند."
        },
        {
          "en": "I think you should get a new job.",
          "fa": "فکر می‌کنم باید کار جدیدی بگیری."
        },
        {
          "en": "I don't think you should speak to him.",
          "fa": "فکر نمی‌کنم باید با او حرف بزنی."
        }
      ],
      "notes_fa": "بعد از should فعل پایه می‌آید: should go (نه should to go). می‌توان به‌جای آن از ought to هم استفاده کرد."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "first conditional: if + present, will / won't + infinitive",
      "title_fa": "شرطی نوع اول",
      "use_fa": "برای موقعیت ممکن در آینده و نتیجه‌اش. جملهٔ if با حال ساده و جملهٔ نتیجه با will/won't + فعل پایه.",
      "formulas": [
        {
          "label_fa": "الگو",
          "text": "If + present, will/won't + base verb\nIf you tell her, she won't believe you."
        },
        {
          "label_fa": "ترتیب",
          "text": "If-clause first or second\nShe won't be happy if you don't go."
        },
        {
          "label_fa": "جای will",
          "text": "imperative or can\nIf you miss the bus, get a taxi."
        }
      ],
      "examples": [
        {
          "en": "If we get to the airport early, the flight will be delayed.",
          "fa": "اگر زود به فرودگاه برسیم، پرواز تأخیر می‌کند."
        },
        {
          "en": "If you tell her the truth, she won't believe you.",
          "fa": "اگر حقیقت را به او بگویی، باور نمی‌کند."
        },
        {
          "en": "What will you do if you don't find a job?",
          "fa": "اگر کار پیدا نکنی چه می‌کنی؟"
        },
        {
          "en": "If you miss the last bus, get a taxi.",
          "fa": "اگر اتوبوس آخر را از دست دادی، تاکسی بگیر."
        }
      ],
      "notes_fa": "در جملهٔ if هرگز will نمی‌آید: If it rains (نه If it will rain). comma وقتی if اول جمله است."
    },
    {
      "key": "t3",
      "position": 3,
      "title_en": "possessive pronouns",
      "title_fa": "ضمیرهای ملکی",
      "use_fa": "به‌جای «صفت ملکی + اسم» می‌آیند: mine یعنی my + noun. با اسم نمی‌آیند.",
      "formulas": [
        {
          "label_fa": "جدول",
          "text": "my → mine\nyour → yours\nhis → his\nher → hers\nour → ours\ntheir → theirs"
        },
        {
          "label_fa": "پرسش",
          "text": "Whose coat is it?\nIt's mine. / Is it yours?"
        }
      ],
      "examples": [
        {
          "en": "Whose coat is it? — It's mine.",
          "fa": "این پالتوی کیست؟ — مال من است."
        },
        {
          "en": "Whose jacket is it? — It's yours.",
          "fa": "این کاپشن کیست؟ — مال توست."
        },
        {
          "en": "Whose phone is it? — It's his.",
          "fa": "این تلفن کیست؟ — مال اوست."
        },
        {
          "en": "Whose house is it? — It's theirs.",
          "fa": "این خانهٔ کیست؟ — مال آن‌هاست."
        }
      ],
      "notes_fa": "ضمیر ملکی با اسم نمی‌آید: It's mine (نه mine book). با the هم نمی‌آید."
    }
  ],
