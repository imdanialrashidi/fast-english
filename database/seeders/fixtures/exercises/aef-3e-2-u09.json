  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "second conditional: if + past, would / wouldn't + base form",
      "title_fa": "شرطی نوع دوم",
      "use_fa": "برای موقعیت خیالی یا غیرواقعی در آینده و نتیجه‌اش. جملهٔ if با گذشتهٔ ساده و نتیجه با would/wouldn't + فعل پایه.",
      "formulas": [
        {
          "label_fa": "الگو",
          "text": "If + past simple, would/wouldn't + base verb\nIf a cow attacked me, I'd run away."
        },
        {
          "label_fa": "ترتیب",
          "text": "I'd exercise more if I had more time."
        },
        {
          "label_fa": "could/were",
          "text": "If we went by car, we could stop.\nIf I were you, I wouldn't take that job."
        }
      ],
      "examples": [
        {
          "en": "If a cow attacked me, I'd run away.",
          "fa": "اگر گاوی به من حمله می‌کرد، فرار می‌کردم."
        },
        {
          "en": "If she didn't have a dog, she wouldn't exercise.",
          "fa": "اگر سگ نداشت، ورزش نمی‌کرد."
        },
        {
          "en": "Would you go for a swim if there were sharks?",
          "fa": "اگر کوسه بود شنا می‌رفتی؟"
        },
        {
          "en": "If I were you, I wouldn't take that job.",
          "fa": "اگر جای تو بودم، آن کار را قبول نمی‌کردم."
        }
      ],
      "notes_fa": "در جملهٔ if شرطی دوم گذشته می‌آید، نه would: If I had (نه If I would have). با be از were استفاده می‌کنیم."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "present perfect + for and since",
      "title_fa": "حال کامل با for و since",
      "use_fa": "برای کاری که در گذشته شروع شده و هنوز ادامه دارد. for با مدت زمان و since با نقطهٔ شروع.",
      "formulas": [
        {
          "label_fa": "for",
          "text": "for + period\nfor 20 years / for three months"
        },
        {
          "label_fa": "since",
          "text": "since + starting point\nsince 2015 / since last June"
        },
        {
          "label_fa": "سؤال",
          "text": "How long have you lived there?"
        }
      ],
      "examples": [
        {
          "en": "I've lived there for 20 years.",
          "fa": "بیست سال است آنجا زندگی می‌کنم."
        },
        {
          "en": "I've worked there since 2015.",
          "fa": "از ۲۰۱۵ آنجا کار می‌کنم."
        },
        {
          "en": "How long have you been married?",
          "fa": "چند وقت است ازدواج کرده‌اید؟"
        },
        {
          "en": "I've been afraid of spiders since I was a child.",
          "fa": "از بچگی از عنکبوت می‌ترسم."
        }
      ],
      "notes_fa": "با for/since حال کامل می‌آید، نه حال ساده: I've lived here for 20 years (نه I live here for 20 years)."
    },
    {
      "key": "t3",
