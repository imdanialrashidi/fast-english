  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "expressing movement",
      "title_fa": "بیان حرکت",
      "use_fa": "فعل حرکت + حرف اضافهٔ حرکت: over، across، into، out of، up، down، away. into/out of با اسم می‌آیند و in/out بدون اسم.",
      "formulas": [
        {
          "label_fa": "حروف حرکت",
          "text": "run over the bridge\nwalk across the park\ngo out of the house\ncome into the room"
        },
        {
          "label_fa": "in/out",
          "text": "Come in.\nHe went out."
        },
        {
          "label_fa": "come/go",
          "text": "come = toward you\ngo = away from you"
        }
      ],
      "examples": [
        {
          "en": "I ran over the bridge and across the park.",
          "fa": "از روی پل دویدم و از پارک گذشتم."
        },
        {
          "en": "He went out of the house.",
          "fa": "او از خانه بیرون رفت."
        },
        {
          "en": "Come into the living room.",
          "fa": "بیا داخل اتاق نشیمن."
        },
        {
          "en": "She ran away.",
          "fa": "او فرار کرد."
        }
      ],
      "notes_fa": "into و out of با اسم می‌آیند (into the room) ولی in و out بدون اسم (come in)."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "word order of phrasal verbs",
      "title_fa": "ترتیب کلمات افعال عبارتی",
      "use_fa": "فعل عبارتی = فعل + حرف. بعضی مفعول‌دار و جداپذیرند (turn off the TV / turn the TV off) ولی اگر مفعول ضمیر باشد همیشه وسط می‌آید (turn it off). بعضی جدا نمی‌شوند (look for).",
      "formulas": [
        {
          "label_fa": "جداپذیر",
          "text": "turn off the TV\nturn the TV off\nturn it off"
        },
        {
          "label_fa": "غیرجداپذیر",
          "text": "look for my glasses\nlook for them"
        },
        {
          "label_fa": "بدون مفعول",
          "text": "get up\ngo out"
        }
      ],
      "examples": [
        {
          "en": "What time do you get up?",
          "fa": "چه ساعتی بیدار می‌شوی؟"
        },
        {
          "en": "Put on your coat. / Put your coat on.",
          "fa": "پالتویت را بپوش."
        },
        {
          "en": "Turn it off!",
          "fa": "خاموشش کن!"
        },
        {
          "en": "I'm looking for my glasses.",
          "fa": "دنبال عینکم می‌گردم."
        }
      ],
      "notes_fa": "با ضمیر، حرف بعد از فعل و قبل از ضمیر می‌آید: turn it off (نه turn off it). look for جدا نمی‌شود."
    },
    {
      "key": "t3",
      "position": 3,
      "title_en": "the passive: be + past participle",
      "title_fa": "مجهول: be + قسمت سوم فعل",
      "use_fa": "وقتی مهم نیست یا نمی‌دانیم چه کسی کار را انجام داده. با am/is/are/was/were + past participle.",
      "formulas": [
        {
          "label_fa": "حال",
          "text": "am / is / are + past participle\nLego is produced every year."
        },
        {
          "label_fa": "منفی/سؤال",
          "text": "CDs aren't used.\nIs Spanish spoken here?"
        },
        {
          "label_fa": "گذشته",
          "text": "was / were + past participle\nThe window was broken."
        }
      ],
      "examples": [
        {
          "en": "20 billion pieces of Lego are produced every year.",
          "fa": "سالانه ۲۰ میلیارد قطعه لگو تولید می‌شود."
        },
        {
          "en": "CDs aren't used very much nowadays.",
          "fa": "این روزها CD زیاد استفاده نمی‌شود."
        },
        {
          "en": "Is Spanish spoken in New Mexico?",
          "fa": "در نیومکزیکو اسپانیایی صحبت می‌شود؟"
        },
        {
          "en": "The window was broken yesterday.",
          "fa": "پنجره دیروز شکسته شد."
        }
      ],
      "notes_fa": "در مجهول، مفعول جملهٔ معلوم فاعل می‌شود و فعل به be + قسمت سوم تبدیل می‌شود: They produce Lego → Lego is produced."
    }
  ],
