  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "past perfect",
      "title_fa": "گذشتهٔ کامل",
      "use_fa": "برای کاری که قبل از یک کار گذشتهٔ دیگر اتفاق افتاده است. با had/hadn't + قسمت سوم فعل.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "subject + had + past participle\nIt had snowed during the night."
        },
        {
          "label_fa": "منفی",
          "text": "hadn't + past participle\nThe game hadn't started."
        },
        {
          "label_fa": "سؤالی",
          "text": "Had you been there before?\nYes, I had. / No, I hadn't."
        }
      ],
      "examples": [
        {
          "en": "When I woke up, it had snowed during the night.",
          "fa": "وقتی بیدار شدم، شب برف آمده بود."
        },
        {
          "en": "I realized that I had left my phone in the taxi.",
          "fa": "فهمیدم تلفنم را در تاکسی جا گذاشته بودم."
        },
        {
          "en": "The game hadn't started.",
          "fa": "بازی شروع نشده بود."
        },
        {
          "en": "Had you been there before? — No, I hadn't.",
          "fa": "قبلاً آنجا بودی؟ — نه."
        }
      ],
      "notes_fa": "گذشتهٔ کامل برای «گذشتهٔ قبل از گذشته» است. 'd می‌تواند had یا would باشد؛ از جمله معلوم می‌شود."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "reported (or indirect) speech",
      "title_fa": "نقل قول غیرمستقیم",
      "use_fa": "برای گفتن حرف کسی دیگر. با said/told و تغییر زمان فعل به یک مرحله عقب‌تر.",
      "formulas": [
        {
          "label_fa": "الگو",
          "text": "He said (that) he loved me.\nShe told me (that) she was tired."
        },
        {
          "label_fa": "تغییر زمان",
          "text": "present → past\nwill → would\ncan → could\npast/present perfect → past perfect"
        }
      ],
      "examples": [
        {
          "en": "He said that he loved me.",
          "fa": "او گفت که دوستم دارد."
        },
        {
          "en": "She told me that she was tired.",
          "fa": "او به من گفت خسته است."
        },
        {
          "en": "He told me he would call me.",
          "fa": "او گفت به من زنگ می‌زند."
        },
        {
          "en": "She said she had broken her arm.",
          "fa": "او گفت بازویش را شکسته است."
        }
      ],
      "notes_fa": "say بدون مفعول و tell با مفعول می‌آید: He said (that) ... / He told me (that) ..."
    },
    {
      "key": "t3",
      "position": 3,
      "title_en": "questions without auxiliaries",
      "title_fa": "سؤال‌های بدون فعل کمکی",
      "use_fa": "وقتی who/what/which خودش فاعل جمله است، از do/does/did استفاده نمی‌کنیم و ترتیب جملهٔ مثبت می‌ماند.",
      "formulas": [
        {
          "label_fa": "فاعل پرسشی",
          "text": "Who directed the movie?\nWhich city has the most people?\nHow many people came?"
        },
        {
          "label_fa": "مقایسه",
          "text": "Who did you see? (who = مفعول)\nWho saw you? (who = فاعل)"
        }
      ],
      "examples": [
        {
          "en": "Who directed the movie?",
          "fa": "فیلم را چه کسی کارگردانی کرد؟"
        },
        {
          "en": "Which city has the most people?",
          "fa": "کدام شهر بیشترین جمعیت را دارد؟"
        },
        {
          "en": "How many people came to the party?",
          "fa": "چند نفر به مهمانی آمدند؟"
        },
        {
          "en": "Who told you that?",
          "fa": "چه کسی این را به تو گفت؟"
        }
      ],
      "notes_fa": "اگر کلمهٔ پرسشی فاعل باشد، فعل کمکی نمی‌آید: Who came? (نه Who did come?)"
    }
  ],
