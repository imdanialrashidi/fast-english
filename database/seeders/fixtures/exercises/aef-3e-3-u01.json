  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "simple present and continuous, action and nonaction verbs",
      "title_fa": "حال ساده و استمراری، فعل‌های کنشی و غیرکنشی",
      "use_fa": "حال ساده برای عادت و حقیقت همیشگی؛ حال استمراری برای کاری که همین حالا در جریان است. برخی فعل‌ها (believe، want، seem) در حال استمراری نمی‌آیند.",
      "formulas": [
        {
          "label_fa": "حال ساده",
          "text": "I live in New York.\nShe works in a restaurant.\nDo you know David?"
        },
        {
          "label_fa": "حال استمراری",
          "text": "The phone's ringing.\nHouse prices are going up."
        },
        {
          "label_fa": "غیرکنشی",
          "text": "I don't believe it. (نه I'm not believing)\nKate doesn't want dinner."
        }
      ],
      "examples": [
        {
          "en": "I live in New York.",
          "fa": "من در نیویورک زندگی می‌کنم."
        },
        {
          "en": "The phone's ringing.",
          "fa": "تلفن زنگ می‌خورد."
        },
        {
          "en": "I don't believe that you cooked this.",
          "fa": "باور نمی‌کنم این را خودت پخته باشی."
        },
        {
          "en": "The check seems very high.",
          "fa": "صورت‌حساب خیلی زیاد به نظر می‌رسد."
        }
      ],
      "notes_fa": "فعل‌های حالت مثل believe، want، seem، know در حال استمراری نمی‌آیند: I don't believe (نه I'm not believing)."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "future forms: present continuous, be going to, will / won't",
      "title_fa": "شکل‌های آینده: حال استمراری، be going to و will",
      "use_fa": "be going to برای تصمیم گرفته‌شده و پیش‌بینی با شواهد؛ حال استمراری برای قرار با زمان و مکان مشخص؛ will برای نظر، پیشنهاد و تصمیم لحظه‌ای.",
      "formulas": [
        {
          "label_fa": "be going to",
          "text": "My sister is going to adopt a child.\nLook at those clouds — it's going to rain."
        },
        {
          "label_fa": "حال استمراری",
          "text": "We're meeting at 10:00 tomorrow.\nJane's leaving on Friday."
        },
        {
          "label_fa": "will/won't",
          "text": "I think it will rain.\nI'll help you with that."
        }
      ],
      "examples": [
        {
          "en": "My sister is going to adopt a child.",
          "fa": "خواهرم قصد دارد بچه به فرزندی بگیرد."
        },
        {
          "en": "We're meeting at 10:00 tomorrow.",
          "fa": "فردا ساعت ۱۰ همدیگر را می‌بینیم."
        },
        {
          "en": "Look at those black clouds! It's going to rain.",
          "fa": "آن ابرهای سیاه را ببین! باران می‌آید."
        },
        {
          "en": "I think it will rain tomorrow.",
          "fa": "فکر می‌کنم فردا باران می‌آید."
        }
      ],
      "notes_fa": "برای برنامهٔ از قبل تصمیم‌گرفته‌شده will نمی‌آید: My sister is going to adopt (نه will adopt)."
    }
  ],
