  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "present perfect and simple past",
      "title_fa": "حال کامل و گذشتهٔ ساده",
      "use_fa": "حال کامل برای تجربه بدون زمان مشخص و کارهای تازه؛ گذشتهٔ ساده برای کار تمام‌شده با زمان مشخص.",
      "formulas": [
        {
          "label_fa": "حال کامل",
          "text": "have/has + past participle\nI've inherited some money.\nHave you ever lost your card?"
        },
        {
          "label_fa": "گذشته",
          "text": "verb-ed / irregular\nThey got married last year.\nWhat time did you wake up?"
        },
        {
          "label_fa": "قیدها",
          "text": "ever/never/already before the verb\nyet at the end"
        }
      ],
      "examples": [
        {
          "en": "I've inherited some money, but I haven't spent it.",
          "fa": "پولی به ارث برده‌ام ولی خرجش نکرده‌ام."
        },
        {
          "en": "Have you ever lost your credit card?",
          "fa": "تا حالا کارت اعتباریت را گم کرده‌ای؟"
        },
        {
          "en": "They got married last year.",
          "fa": "آن‌ها سال گذشته ازدواج کردند."
        },
        {
          "en": "What time did you wake up this morning?",
          "fa": "امروز صبح چه ساعتی بیدار شدی؟"
        }
      ],
      "notes_fa": "با زمان مشخص (last year، yesterday) گذشتهٔ ساده می‌آید؛ با تجربهٔ بدون زمان، حال کامل: I've been to Miami twice."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "present perfect + for / since, present perfect continuous",
      "title_fa": "حال کامل با for/since و حال کامل استمراری",
      "use_fa": "برای کاری که در گذشته شروع شده و هنوز ادامه دارد: for + مدت، since + نقطهٔ شروع. حال کامل استمراری روی ادامهٔ فعالیت تأکید دارد.",
      "formulas": [
        {
          "label_fa": "حال کامل + for/since",
          "text": "They've known each other for ten years.\nJulia's had that bag since college."
        },
        {
          "label_fa": "حال کامل استمراری",
          "text": "have/has been + verb-ing\nHow long have you been learning English?"
        }
      ],
      "examples": [
        {
          "en": "They've known each other for ten years.",
          "fa": "ده سال است همدیگر را می‌شناسند."
        },
        {
          "en": "Julia's had that bag since college.",
          "fa": "جولیا از دوران دانشگاه آن کیف را دارد."
        },
        {
          "en": "How long have you been learning English?",
          "fa": "چند وقت است انگلیسی یاد می‌گیری؟"
        },
        {
          "en": "Have you been crying? — No, I've been chopping onions.",
          "fa": "گریه کرده‌ای؟ — نه، پیاز خرد می‌کردم."
        }
      ],
      "notes_fa": "با for/since حال کامل می‌آید، نه حال ساده: They've known (نه They know) each other for ten years."
    }
  ],
