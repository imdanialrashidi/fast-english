  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "obligation and prohibition: have to, must, should",
      "title_fa": "اجبار و ممنوعیت: have to، must و should",
      "use_fa": "have to و must برای اجبار و کار لازم؛ must not برای ممنوعیت؛ don't have to یعنی لازم نیست؛ should برای توصیه.",
      "formulas": [
        {
          "label_fa": "اجبار",
          "text": "have to / has to + base verb\nYou have to turn off your phone."
        },
        {
          "label_fa": "ممنوعیت",
          "text": "must not + base verb\nYou must not send texts while driving."
        },
        {
          "label_fa": "عدم اجبار",
          "text": "don't / doesn't have to\nYou don't have to pay."
        }
      ],
      "examples": [
        {
          "en": "You have to turn off your phone during take-off.",
          "fa": "باید هنگام برخاستن هواپیما تلفنت را خاموش کنی."
        },
        {
          "en": "You must be on time tomorrow.",
          "fa": "فردا باید سر وقت باشی."
        },
        {
          "en": "You don't have to pay — the museum is free.",
          "fa": "لازم نیست پول بدهی — موزه رایگان است."
        },
        {
          "en": "You must not send text messages when driving.",
          "fa": "هنگام رانندگی نباید پیام بفرستی."
        }
      ],
      "notes_fa": "must not با don't have to فرق دارد: اولی ممنوعیت و دومی «لازم نیست». have to در همهٔ زمان‌ها می‌آید: had to، having to."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "ability and possibility: can, could, be able to",
      "title_fa": "توانایی و امکان: can، could و be able to",
      "use_fa": "can برای حال، could برای گذشته/درخواست مؤدبانه، و be able to برای زمان‌هایی که can شکل ندارد (حال کامل، آینده، مصدر، ing).",
      "formulas": [
        {
          "label_fa": "can/could",
          "text": "I can speak three languages.\nShe could play the violin when she was three."
        },
        {
          "label_fa": "be able to",
          "text": "have been able to\nwill be able to\nwould like to be able to\nbeing able to"
        }
      ],
      "examples": [
        {
          "en": "I can speak three languages fluently.",
          "fa": "من سه زبان را روان صحبت می‌کنم."
        },
        {
          "en": "She could play the violin when she was three.",
          "fa": "او سه‌ساله بود که ویولن می‌نواخت."
        },
        {
          "en": "Luke has been able to swim since he was three.",
          "fa": "لوک از سه‌سالگی شنا می‌تواند."
        },
        {
          "en": "You'll be able to practice your English.",
          "fa": "خواهی توانست انگلیسی تمرین کنی."
        }
      ],
      "notes_fa": "برای آینده و حال کامل از can استفاده نمی‌کنیم: will be able to / has been able to. could برای درخواست مؤدبانه هم می‌آید: Could you open the door?"
    }
  ],
