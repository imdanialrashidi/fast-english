  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "present perfect simple and continuous",
      "title_fa": "حال کامل ساده و استمراری",
      "use_fa": "حال کامل ساده برای تجربه و نتیجه؛ حال کامل استمراری برای فعالیتی که تا حالا ادامه داشته و بر طول آن تأکید دارد.",
      "formulas": [
        {
          "label_fa": "ساده",
          "text": "have/has + past participle\nI've known Keiko since childhood."
        },
        {
          "label_fa": "استمراری",
          "text": "have/has been + verb-ing\nHow long have you been waiting?"
        }
      ],
      "examples": [
        {
          "en": "Have you ever broken a bone?",
          "fa": "تا حالا استخوانت شکسته؟"
        },
        {
          "en": "I've known Keiko since I was a child.",
          "fa": "از بچگی کیکو را می‌شناسم."
        },
        {
          "en": "How long have you been waiting?",
          "fa": "چه مدت منتظر بوده‌ای؟"
        },
        {
          "en": "It's been raining all day.",
          "fa": "تمام روز باران باریده است."
        }
      ],
      "notes_fa": "فعل‌های غیرکنشی مثل know با حال کامل ساده می‌آیند، نه استمراری. استمراری روی ادامهٔ فعالیت تأکید دارد."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "using adjectives as nouns, adjective order",
      "title_fa": "صفت به‌جای اسم و ترتیب صفت‌ها",
      "use_fa": "the + صفت برای اشاره به یک گروه (the young). ترتیب صفت‌ها: نظر، اندازه/سن، رنگ، جنس: a beautiful Italian leather belt.",
      "formulas": [
        {
          "label_fa": "گروه",
          "text": "the young / the poor / the unemployed\nthe English / the Chinese"
        },
        {
          "label_fa": "ترتیب",
          "text": "opinion + age + color + material\ncharming old house\nlong brown hair\nbeautiful Italian leather belt"
        }
      ],
      "examples": [
        {
          "en": "The young still look up to the old.",
          "fa": "جوان‌ها هنوز به بزرگ‌ترها احترام می‌گذارند."
        },
        {
          "en": "The poor are getting poorer.",
          "fa": "فقیرها فقیرتر می‌شوند."
        },
        {
          "en": "We have a charming old house.",
          "fa": "ما خانهٔ قدیمی دل‌انگیزی داریم."
        },
        {
          "en": "She has long brown hair.",
          "fa": "او موهای بلند قهوه‌ای دارد."
        }
      ],
      "notes_fa": "برای یک نفر از a/an + صفت استفاده می‌کنیم: a Japanese woman (نه a Japanese). ترتیب صفت در انگلیسی ثابت است."
    }
  ],
