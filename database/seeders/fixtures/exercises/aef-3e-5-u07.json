  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "permission, obligation, and necessity",
      "title_fa": "اجازه، اجبار و ضرورت",
      "use_fa": "can برای اجازه؛ must برای اجبار قوی/قانون؛ have to برای اجبار بیرونی؛ don't have to/needn't یعنی لازم نیست؛ mustn't یعنی ممنوع؛ should/ought to برای توصیه و had better برای هشدار.",
      "formulas": [
        {
          "label_fa": "اجازه/ممنوعیت",
          "text": "Can I use your phone?\nYou mustn't park here."
        },
        {
          "label_fa": "اجبار/عدم اجبار",
          "text": "I had to work on Saturday.\nYou don't have to / needn't bring a towel."
        },
        {
          "label_fa": "توصیه",
          "text": "You should see a doctor.\nYou'd better leave now."
        }
      ],
      "examples": [
        {
          "en": "You mustn't park here — it's not allowed.",
          "fa": "اینجا نباید پارک کنی؛ مجاز نیست."
        },
        {
          "en": "You don't have to bring a towel; the hotel provides them.",
          "fa": "لازم نیست حوله بیاوری؛ هتل می‌دهد."
        },
        {
          "en": "You should see a doctor.",
          "fa": "باید دکتر بروی."
        },
        {
          "en": "You'd better leave now, or you'll miss the train.",
          "fa": "بهتر است الان بروی وگرنه قطار را از دست می‌دهی."
        }
      ],
      "notes_fa": "mustn't با don't have to فرق دارد: اولی ممنوع و دومی لازم نیست. needn't هم یعنی لازم نیست."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "verbs of the senses",
      "title_fa": "فعل‌های حسی با مفعول",
      "use_fa": "hear/see/smell/feel/taste + مفعول + فعل پایه (کل عمل) یا ing (در جریان).",
      "formulas": [
        {
          "label_fa": "فعل پایه",
          "text": "I saw him cross the road."
        },
        {
          "label_fa": "ing",
          "text": "I heard her singing."
        }
      ],
      "examples": [
        {
          "en": "I saw him cross the road.",
          "fa": "دیدم از خیابان رد شد."
        },
        {
          "en": "I heard her singing in the shower.",
          "fa": "شنیدم در حمام آواز می‌خواند."
        },
        {
          "en": "We could smell the cake baking.",
          "fa": "بوی کیک در حال پختن را حس می‌کردیم."
        },
        {
          "en": "I felt the ground shake.",
          "fa": "حس کردم زمین لرزید."
        }
      ],
      "notes_fa": "با ing عمل در جریان است و با فعل پایه کل عمل دیده/شنیده می‌شود: saw him cross / saw him crossing."
    }
