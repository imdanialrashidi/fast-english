      "title_fa": "اسم مصدر و مصدر (پیشرفته)",
      "use_fa": "بعد از حرف اضافه و برخی عبارت‌ها ing می‌آید (apologize for, look forward to, no use, can't help)؛ بعد از too/enough و decide/suggest (ساختار مناسب) to؛ بعد از would rather/better فعل پایه.",
      "formulas": [
        {
          "label_fa": "ing",
          "text": "used to getting up early\napologized for being late\ndenied taking it\nno use complaining"
        },
        {
          "label_fa": "to / پایه",
          "text": "too tired to walk\nold enough to drive\nI'd rather stay"
        }
      ],
      "examples": [
        {
          "en": "I'm used to getting up early.",
          "fa": "به زود بیدار شدن عادت دارم."
        },
        {
          "en": "She apologized for being late.",
          "fa": "او برای دیر رسیدن عذرخواهی کرد."
        },
        {
          "en": "He denied taking the money.",
          "fa": "او انکار کرد که پول را گرفته است."
        },
        {
          "en": "It's no use complaining about it.",
          "fa": "شکایت کردن دربارهٔ آن فایده‌ای ندارد."
        }
      ],
      "notes_fa": "بعد از look forward to و used to (عادت) فعل ing می‌آید، نه مصدر."
    },
