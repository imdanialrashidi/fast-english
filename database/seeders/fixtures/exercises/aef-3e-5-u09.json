  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "ellipsis",
      "title_fa": "حذف (ellipsis)",
      "use_fa": "در انگلیسی طبیعی بخش‌های تکراری جمله حذف می‌شوند: بعد از فعل کمکی، بعد از to، و بعد از پیوندها (if you want to, but I don't know why).",
      "formulas": [
        {
          "label_fa": "فعل کمکی",
          "text": "I'd love to come, but I can't.\nShe can play the piano and her sister can too."
        },
        {
          "label_fa": "بعد از پیوند",
          "text": "You can go if you want to.\nHe didn't come, but I don't know why."
        }
      ],
      "examples": [
        {
          "en": "I'd love to come, but I can't.",
          "fa": "دوست دارم بیایم ولی نمی‌توانم."
        },
        {
          "en": "She can play the piano and her sister can too.",
          "fa": "او پیانو می‌نوازد و خواهرش هم می‌تواند."
        },
        {
          "en": "You can go if you want to.",
          "fa": "اگر بخواهی می‌توانی بروی."
        },
        {
          "en": "He didn't come, but I don't know why.",
          "fa": "او نیامد ولی نمی‌دانم چرا."
        }
      ],
      "notes_fa": "بعد از to در پاسخ کوتاه، فعل تکرار نمی‌شود: I'd love to (come). بعد از can't/can هم فعل حذف می‌شود."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "nouns: compound and possessive forms",
      "title_fa": "اسم‌های مرکب و ملکی",
      "use_fa": "اسم مرکب: اسم اول اسم دوم را توصیف می‌کند (coffee table). مالکیت با 's برای افراد و برخی چیزها؛ جمع بی‌قاعده children's و women's.",
      "formulas": [
        {
          "label_fa": "مرکب",
          "text": "can opener / coffee table / tennis racket / shoe polish"
        },
        {
          "label_fa": "ملکی",
          "text": "my sister's car / the doctor's office / children's toys"
        }
      ],
      "examples": [
        {
          "en": "I need a new can opener.",
          "fa": "به یابازکن نو نیاز دارم."
        },
        {
          "en": "She bought a coffee table.",
          "fa": "او میز جلومبلی خرید."
        },
        {
          "en": "It's my sister's car.",
          "fa": "ماشین خواهرم است."
        },
        {
          "en": "The children's toys are everywhere.",
          "fa": "اسباب‌بازی‌های بچه‌ها همه‌جا پخش است."
        }
      ],
      "notes_fa": "در اسم مرکب، اسم اول مفرد می‌ماند: shoe polish (نه shoes polish). مالکیت جمع بی‌قاعده: children's."
    }
  ],
