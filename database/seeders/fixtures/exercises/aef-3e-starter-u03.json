  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "singular and plural nouns; a / an",
      "title_fa": "اسم مفرد و جمع؛ a / an",
      "use_fa": "برای نام بردن یک چیز مفرد از a یا an استفاده می‌کنیم و برای چند چیز، اسم را جمع می‌بندیم. a قبل از صدای صامت و an قبل از صدای مصوت می‌آید.",
      "formulas": [
        {
          "label_fa": "مفرد",
          "text": "a / an + singular noun\nIt's a book. / It's an umbrella."
        },
        {
          "label_fa": "جمع",
          "text": "noun + -s / -es\nThey're books. / They're watches.\nconsonant + y → -ies: countries"
        },
        {
          "label_fa": "سؤالی",
          "text": "What is it? — It's a key.\nWhat are they? — They're keys."
        }
      ],
      "examples": [
        {
          "en": "It's a key.",
          "fa": "این یک کلید است."
        },
        {
          "en": "It's an ID card.",
          "fa": "این یک کارت شناسایی است."
        },
        {
          "en": "They're watches.",
          "fa": "این‌ها ساعت مچی‌اند."
        },
        {
          "en": "They're dictionaries.",
          "fa": "این‌ها فرهنگ لغت‌اند."
        }
      ],
      "notes_fa": "a + صامت (a bag, a phone) و an + مصوت (an umbrella, an ID card). برای جمع: -s معمول، -es بعد از ch/sh/s/ss/x، و y بعد از صامت به ies تبدیل می‌شود."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "this / that / these / those",
      "title_fa": "this، that، these و those",
      "use_fa": "برای اشاره به چیزها و افراد: this/these برای چیزهای نزدیک و that/those برای چیزهای دور. this و that مفردند و these و those جمع.",
      "formulas": [
        {
          "label_fa": "نزدیک",
          "text": "this + singular noun\nThese + plural noun\nThis is my book. / These are my keys."
        },
        {
          "label_fa": "دور",
          "text": "that + singular noun\nThose + plural noun\nThat is my car. / Those are my friends."
        },
        {
          "label_fa": "سؤالی",
          "text": "What's this? — It's a key.\nWhat are those? — They're cats."
        }
      ],
      "examples": [
        {
          "en": "What's this? — It's a key.",
          "fa": "این چیست؟ — یک کلید است."
        },
        {
          "en": "What are those? — They're cats.",
          "fa": "آن‌ها چیستند؟ — گربه‌اند."
        },
        {
          "en": "This is my brother.",
          "fa": "این برادرم است."
        },
        {
          "en": "Who are those girls over there?",
          "fa": "آن دخترها آن‌طرف کی هستند؟"
        }
      ],
      "notes_fa": "this/these = here (نزدیک)، that/those = there / over there (دور). این کلمه‌ها هم ضمیرند و هم صفت: This is my book. / This book is nice."
    }
  ],
