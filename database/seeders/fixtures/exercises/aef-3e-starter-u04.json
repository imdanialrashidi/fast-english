  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "possessive adjectives; possessive 's",
      "title_fa": "صفات ملکی و آپاستروف s",
      "use_fa": "برای گفتن اینکه چیزی مال کیست: صفت ملکی قبل از اسم می‌آید (my name) و s' بعد از اسمِ صاحبِ چیز (Jack's car).",
      "formulas": [
        {
          "label_fa": "صفات ملکی",
          "text": "I → my\nYou → your\nHe → his\nShe → her\nIt → its\nWe → our\nThey → their\n+ noun"
        },
        {
          "label_fa": "مالکیت با s'",
          "text": "person + 's + noun\nJack's car\nMaria's sister\nCarlos's brother"
        },
        {
          "label_fa": "جمع",
          "text": "plural people + ' + noun\nmy parents' house\nmy brothers' room"
        }
      ],
      "examples": [
        {
          "en": "This is Jack's car.",
          "fa": "این ماشین جک است."
        },
        {
          "en": "Her name is Satoko.",
          "fa": "اسم او ساتوکو است."
        },
        {
          "en": "Their names are Pedro and Maria.",
          "fa": "اسم آن‌ها پدرو و ماریاست."
        },
        {
          "en": "Its name is Kebob Kitchen.",
          "fa": "اسمش کباب کیچن است."
        }
      ],
      "notes_fa": "its (مالِ آن) با it's (it is) فرق دارد. برای اسمی که به s ختم می‌شود، s's می‌آید (Carlos's) و برای جمع، فقط آپاستروف: my parents' house."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "adjectives",
      "title_fa": "صفت‌ها",
      "use_fa": "صفت چیزی را توصیف می‌کند: بعد از فعل be می‌آید یا قبل از اسم. صفت برای مفرد و جمع یک شکل دارد.",
      "formulas": [
        {
          "label_fa": "بعد از be",
          "text": "subject + be + adjective\nAn Audi is expensive.\nThey're old houses."
        },
        {
          "label_fa": "قبل از اسم",
          "text": "adjective + noun\nIt's a fast car.\nThey're old houses."
        },
