  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "simple present [+] and [-]: I, you, we, they",
      "title_fa": "حال ساده مثبت و منفی: I، you، we، they",
      "use_fa": "برای عادت‌های روزمره و چیزهایی که همیشه درست‌اند. این ساختار برای I، you، we و they یک شکل دارد.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "I / You / We / They + base verb + ...\nI have cereal for breakfast."
        },
        {
          "label_fa": "منفی",
          "text": "I / You / We / They + don't + base verb + ...\nWe don't have tea.\n(don't = do not)"
        }
      ],
      "examples": [
        {
          "en": "I have cereal for breakfast.",
          "fa": "من صبحانه غلات می‌خورم."
        },
        {
          "en": "You don't have pasta for lunch.",
          "fa": "تو ناهار پاستا نمی‌خوری."
        },
        {
          "en": "We have coffee for breakfast.",
          "fa": "ما صبحانه قهوه می‌نوشیم."
        },
        {
          "en": "They have fish for dinner.",
          "fa": "آن‌ها شام ماهی می‌خورند."
        }
      ],
      "notes_fa": "منفی با don't ساخته می‌شود و فعل بعد از آن به شکل پایه می‌آید: We don't have coffee. (نه We not have coffee.) در این درس he/she/it نیست."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "simple present [?]: I, you, we, they",
      "title_fa": "حال ساده سؤالی: I، you، we، they",
      "use_fa": "برای پرسیدن دربارهٔ عادت‌ها و کارهای روزمره. سؤال با Do شروع می‌شود و فعل به شکل پایه می‌آید.",
      "formulas": [
        {
          "label_fa": "سؤالی",
          "text": "Do + I / you / we / they + base verb + ...?\nDo you live near here?"
        },
        {
          "label_fa": "پاسخ کوتاه",
          "text": "Yes, I / you / we / they do.\nNo, I / you / we / they don't."
        }
      ],
      "examples": [
        {
          "en": "Do you live near here? — Yes, I do.",
          "fa": "نزدیک اینجا زندگی می‌کنی؟ — بله."
        },
        {
          "en": "Do they like children? — No, they don't.",
          "fa": "آن‌ها بچه‌ها را دوست دارند؟ — نه."
        },
        {
          "en": "Do we have good seats? — Yes, we do.",
          "fa": "صندلی‌های خوبی داریم؟ — بله."
        },
        {
          "en": "Do I need a ticket? — Yes, you do.",
          "fa": "من بلیت لازم دارم؟ — بله."
        }
      ],
      "notes_fa": "ترتیب سؤال: Do + فاعل + فعل پایه. خودِ do معنا ندارد؛ فقط سؤال را می‌سازد: Do you live here? (نه You live here?)"
    }
  ],
