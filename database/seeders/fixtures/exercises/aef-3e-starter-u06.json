  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "simple present: he, she, it",
      "title_fa": "حال ساده: he، she، it",
      "use_fa": "برای عادت‌ها و کارهای روزمرهٔ یک نفر یا یک چیز. با he/she/it فعل s می‌گیرد و منفی/سؤالی با does ساخته می‌شود.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "He / She / It + verb + s\nHe works in an office.\nShe studies history."
        },
        {
          "label_fa": "منفی",
          "text": "He / She / It + doesn't + base verb\nHe doesn't work on Sundays."
        },
        {
          "label_fa": "سؤالی",
          "text": "Does + he / she / it + base verb?\nDoes she work here?\nYes, she does. / No, she doesn't."
        }
      ],
      "examples": [
        {
          "en": "He works in an office.",
          "fa": "او در یک دفتر کار می‌کند."
        },
        {
          "en": "She doesn't work on Sundays.",
          "fa": "او یکشنبه‌ها کار نمی‌کند."
        },
        {
          "en": "Does he work here? — Yes, he does.",
          "fa": "او اینجا کار می‌کند؟ — بله."
        },
        {
          "en": "It finishes at 8:00.",
          "fa": "ساعت ۸ تمام می‌شود."
        }
      ],
      "notes_fa": "spelling سوم‌شخص مثل جمع اسم است: work→works، watch→watches، study→studies. سه فعل بی‌قاعده: have→has، go→goes، do→does. بعد از doesn't فعل پایه می‌آید."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "adverbs of frequency",
      "title_fa": "قیدهای تکرار",
      "use_fa": "می‌گویند کاری چند وقت یک‌بار انجام می‌شود: always (همیشه)، usually (معمولاً)، sometimes (گاهی)، never (هرگز).",
      "formulas": [
        {
          "label_fa": "جای قید",
          "text": "subject + adverb + main verb\nI always have breakfast.\nShe usually goes shopping."
        },
        {
          "label_fa": "با never",
          "text": "never + فعل مثبت\nHe never eats meat.\n(نه doesn't eat)"
        },
        {
          "label_fa": "در سؤال",
          "text": "Does she usually go shopping?\nWhat time do you usually get up?"
        }
      ],
      "examples": [
        {
          "en": "I always have breakfast.",
          "fa": "من همیشه صبحانه می‌خورم."
        },
        {
          "en": "They usually finish work at 5:00.",
          "fa": "آن‌ها معمولاً ساعت ۵ کار را تمام می‌کنند."
        },
        {
          "en": "She sometimes watches TV in the evening.",
          "fa": "او گاهی عصر تلویزیون تماشا می‌کند."
        },
        {
          "en": "He never eats meat.",
          "fa": "او هرگز گوشت نمی‌خورد."
        }
      ],
      "notes_fa": "قید تکرار قبل از فعل اصلی می‌آید: I always have breakfast. (نه Always I have breakfast.) با never فعل مثبت است: He never eats meat."
    }
  ],
