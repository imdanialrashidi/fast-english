  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "word order in questions",
      "title_fa": "ترتیب کلمات در سؤال",
      "use_fa": "در سؤال با فعل be، فعل قبل از فاعل می‌آید؛ در سؤال با فعل معمولی، do/does اول می‌آید و بعد فاعل و فعل پایه.",
      "formulas": [
        {
          "label_fa": "سؤال با be",
          "text": "be + subject + ...?\nAre you tired?\nIs this your coat?\nWhere are you from?"
        },
        {
          "label_fa": "سؤال با فعل معمولی",
          "text": "do / does + subject + base verb + ...?\nDo you go out on Friday nights?\nWhere do you go?\nWhat does your sister do?"
        }
      ],
      "examples": [
        {
          "en": "Are you a student?",
          "fa": "دانشجویی؟"
        },
        {
          "en": "Where are you from?",
          "fa": "اهل کجایی؟"
        },
        {
          "en": "Do you go out on Friday nights?",
          "fa": "جمعه شب‌ها بیرون می‌روی؟"
        },
        {
          "en": "What does your sister do?",
          "fa": "خواهرت چه کار می‌کند؟"
        }
      ],
      "notes_fa": "با فعل be از do استفاده نمی‌کنیم: Are you tired? (نه Do you tired?). با فعل معمولی، فعل بعد از فاعل به شکل پایه می‌آید: Where do you go?"
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "imperatives; object pronouns: me, him, etc.",
      "title_fa": "امری و ضمیرهای مفعولی: me، him و…",
      "use_fa": "امری برای دستور و راهنمایی است و برای یک نفر و چند نفر یک شکل دارد. ضمیر مفعولی بعد از فعل یا حرف اضافه می‌آید.",
      "formulas": [
        {
          "label_fa": "امری مثبت",
          "text": "base verb + ...!\nCome here!\nOpen your books."
        },
        {
          "label_fa": "امری منفی",
          "text": "Don't + base verb + ...!\nDon't talk.\nDon't be late."
        },
        {
          "label_fa": "ضمیر مفعولی",
          "text": "I → me\nYou → you\nHe → him\nShe → her\nIt → it\nWe → us\nThey → them\n(after a verb or preposition)"
        }
      ],
      "examples": [
        {
          "en": "Open your books.",
          "fa": "کتاب‌هایتان را باز کنید."
        },
        {
          "en": "Don't be late.",
          "fa": "دیر نکن."
        },
        {
          "en": "Listen to me!",
          "fa": "به من گوش کن!"
        },
        {
          "en": "I see him every week.",
          "fa": "من هر هفته او را می‌بینم."
        }
      ],
      "notes_fa": "ضمیر مفعولی بعد از فعل می‌آید: I love you. (نه I love he.) امری منفی با Don't شروع می‌شود: Don't talk."
    }
  ],
