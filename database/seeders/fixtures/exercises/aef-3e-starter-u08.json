  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "can / can't",
      "title_fa": "can و can't",
      "use_fa": "برای اجازه، امکان و توانایی. can برای همهٔ فاعل‌ها یک شکل دارد و منفی‌اش can't است.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "subject + can + base verb\nI can park here.\nShe can play the guitar."
        },
        {
          "label_fa": "منفی",
          "text": "subject + can't + base verb\nYou can't park there.\n(can't = cannot)"
        },
        {
          "label_fa": "سؤالی",
          "text": "Can + subject + base verb?\nCan I park here?\nYes, you can. / No, you can't."
        }
      ],
      "examples": [
        {
          "en": "Can I park here? — Yes, you can.",
          "fa": "می‌توانم اینجا پارک کنم؟ — بله."
        },
        {
          "en": "You can't park there.",
          "fa": "آن‌جا نمی‌توانی پارک کنی."
        },
        {
          "en": "He can help us.",
          "fa": "او می‌تواند به ما کمک کند."
        },
        {
          "en": "Can you drive? — No, I can't.",
          "fa": "رانندگی می‌توانی؟ — نه."
        }
      ],
      "notes_fa": "can برای همهٔ فاعل‌ها یک شکل است (بدون s). بعد از can فعل پایه می‌آید: She can play (نه can plays). سؤال با Can شروع می‌شود، نه Do."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "like / love / hate + verb + -ing",
      "title_fa": "like، love و hate + فعل ing‌دار",
      "use_fa": "برای گفتن اینکه از چه کاری خوشمان می‌آید یا بدمان می‌آید. بعد از like/love/hate فعل به شکل -ing می‌آید.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "subject + like / love / hate + verb-ing\nI love cooking.\nShe likes going for a walk."
        },
        {
          "label_fa": "منفی",
          "text": "subject + don't / doesn't + like + verb-ing\nI don't like studying.\nHe doesn't like getting up early."
        },
        {
          "label_fa": "سؤالی",
          "text": "What do you like doing on the weekend?\nDo you like cooking?"
        }
      ],
      "examples": [
        {
          "en": "I love cooking.",
          "fa": "من عاشق آشپزی هستم."
        },
        {
          "en": "She likes going for a walk.",
          "fa": "او دوست دارد پیاده‌روی کند."
        },
        {
          "en": "I don't like studying.",
          "fa": "مطالعه کردن را دوست ندارم."
        },
        {
          "en": "He hates getting up early.",
          "fa": "او از زود بیدار شدن متنفر است."
        }
      ],
      "notes_fa": "بعد از like/love/hate فعل -ing می‌گیرد: I like reading. (نه I like read.) در منفی با he/she/it از doesn't استفاده می‌شود و فعل پایه می‌ماند."
    }
  ],
