  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "present continuous",
      "title_fa": "حال استمراری",
      "use_fa": "برای کاری که همین حالا یا همین روزها در جریان است. با am/is/are + فعل ing ساخته می‌شود.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "I am (I'm) + verb-ing\nYou / We / They are + verb-ing\nHe / She / It is + verb-ing"
        },
        {
          "label_fa": "منفی",
          "text": "I'm not + verb-ing\nYou aren't + verb-ing\nHe isn't + verb-ing"
        },
        {
          "label_fa": "سؤالی",
          "text": "Are you + verb-ing?\nIs she + verb-ing?\nYes, I am. / No, I'm not."
        }
      ],
      "examples": [
        {
          "en": "I'm staying in a nice hotel.",
          "fa": "من در یک هتل خوب اقامت دارم."
        },
        {
          "en": "It's raining.",
          "fa": "باران می‌بارد."
        },
        {
          "en": "They aren't watching TV.",
          "fa": "آن‌ها تلویزیون تماشا نمی‌کنند."
        },
        {
          "en": "What are you doing? — I'm making dinner.",
          "fa": "چه کار می‌کنی؟ — شام درست می‌کنم."
        }
      ],
      "notes_fa": "حال استمراری برای «همین حالا» است، نه عادت. فعل ing می‌گیرد: work→working، make→making، run→running."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "present continuous or simple present?",
      "title_fa": "حال استمراری یا حال ساده؟",
      "use_fa": "حال ساده برای عادت و کارهای همیشگی است؛ حال استمراری برای همین حالا، امروز یا این دوره.",
      "formulas": [
        {
          "label_fa": "حال ساده",
          "text": "always / usually / every day + simple present\nI usually wear a suit.\nShe drinks coffee every morning."
        },
        {
          "label_fa": "حال استمراری",
          "text": "now / today / at the moment + present continuous\nToday I'm wearing jeans.\nThey're watching TV now."
        }
      ],
      "examples": [
        {
          "en": "He usually works in an office.",
          "fa": "او معمولاً در دفتر کار می‌کند."
        },
        {
          "en": "Today he's working in a hotel.",
          "fa": "امروز در هتل کار می‌کند."
        },
        {
          "en": "I usually wear a suit.",
          "fa": "من معمولاً کت‌وشلوار می‌پوشم."
        },
        {
          "en": "Today I'm wearing jeans.",
          "fa": "امروز شلوار جین پوشیده‌ام."
        }
      ],
      "notes_fa": "نشانه‌های حال ساده: every day، usually، always. نشانه‌های حال استمراری: now، today، at the moment. فعل حال استمراری همیشه ing دارد."
    }
  ],
