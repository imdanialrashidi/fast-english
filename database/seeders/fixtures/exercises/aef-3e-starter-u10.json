  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "there's a... / there are some...",
      "title_fa": "there's a… / there are some…",
      "use_fa": "برای گفتن اینکه چیزی در جایی هست. برای مفرد there's و برای جمع there are می‌آید؛ some در جملهٔ مثبت و any در منفی و سؤال.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "There's a + singular noun\nThere are some + plural noun\nThere's a TV in the room.\nThere are some pictures."
        },
        {
          "label_fa": "منفی",
          "text": "There isn't a + singular\nThere aren't any + plural\nThere isn't a phone.\nThere aren't any towels."
        },
        {
          "label_fa": "سؤالی",
          "text": "Is there a ...?\nAre there any ...?\nYes, there is. / No, there isn't."
        }
      ],
      "examples": [
        {
          "en": "There's a TV in my hotel room.",
          "fa": "یک تلویزیون در اتاق هتل من هست."
        },
        {
          "en": "There are two beds in the room.",
          "fa": "دو تخت در اتاق هست."
        },
        {
          "en": "There isn't a bathtub.",
          "fa": "وان حمام نیست."
        },
        {
          "en": "Are there any towels? — Yes, there are.",
          "fa": "حوله هست؟ — بله."
        }
      ],
      "notes_fa": "some در جملهٔ مثبت جمع و any در منفی و سؤال می‌آید: There are some towels. / There aren't any towels. / Are there any towels?"
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "simple past: be",
      "title_fa": "گذشتهٔ سادهٔ فعل be",
      "use_fa": "برای صحبت دربارهٔ گذشته: was برای I/he/she/it و were برای you/we/they. منفی was wasn't و were weren't.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "I / He / She / It was ...\nYou / We / They were ...\nI was at home at 8:00."
        },
        {
          "label_fa": "منفی",
          "text": "wasn't / weren't\nI wasn't at home.\nThey weren't in Mexico."
        },
        {
          "label_fa": "سؤالی",
          "text": "Was she a singer?\nWere you late?\nYes, she was. / No, she wasn't."
        }
      ],
      "examples": [
        {
          "en": "I was at home at 8:00.",
          "fa": "من ساعت ۸ خانه بودم."
        },
        {
          "en": "You were in class yesterday.",
          "fa": "تو دیروز سر کلاس بودی."
        },
        {
          "en": "He wasn't tired last night.",
          "fa": "او دیشب خسته نبود."
        },
        {
          "en": "Were they in Mexico last week? — Yes, they were.",
          "fa": "آن‌ها هفتهٔ گذشته در مکزیک بودند؟ — بله."
        }
      ],
      "notes_fa": "was برای مفرد (I/he/she/it) و were برای جمع و you. زمان‌های گذشته: yesterday، last night، last week."
    }
  ],
