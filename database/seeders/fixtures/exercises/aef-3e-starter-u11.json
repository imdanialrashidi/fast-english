  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "simple past: regular verbs",
      "title_fa": "گذشتهٔ ساده: افعال باقاعده",
      "use_fa": "برای کارهایی که در گذشته تمام شده‌اند. فعل با ed جمع می‌بندد و برای همهٔ فاعل‌ها یک شکل است.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "subject + verb + -ed\nI arrived at 7:00.\nShe liked the movie."
        },
        {
          "label_fa": "منفی",
          "text": "subject + didn't + base verb\nI didn't arrive at 7:00."
        },
        {
          "label_fa": "سؤالی",
          "text": "Did + subject + base verb?\nDid you watch TV?\nYes, I did. / No, I didn't."
        }
      ],
      "examples": [
        {
          "en": "I arrived at the airport at 7:00.",
          "fa": "ساعت ۷ به فرودگاه رسیدم."
        },
        {
          "en": "We studied Spanish at school.",
          "fa": "ما در مدرسه اسپانیایی خواندیم."
        },
        {
          "en": "They stopped at a café.",
          "fa": "آن‌ها در یک کافه توقف کردند."
        },
        {
          "en": "Did she walk to work? — Yes, she did.",
          "fa": "او پیاده سر کار رفت؟ — بله."
        }
      ],
      "notes_fa": "قواعد ed: work→worked، live→lived (e + d)، study→studied (y بعد از صامت)، stop→stopped (دوبرابر شدن صامت). بعد از didn't و did فعل پایه می‌آید."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "simple past irregular verbs: get, go, have, do",
      "title_fa": "گذشتهٔ سادهٔ افعال بی‌قاعده: get، go، have، do",
      "use_fa": "چهار فعل پرکاربرد در گذشته شکل خودشان را دارند: get→got، go→went، have→had، do→did. منفی و سؤالی با didn't/did و فعل پایه ساخته می‌شود.",
      "formulas": [
        {
          "label_fa": "مثبت",
          "text": "get → got\ngo → went\nhave → had\ndo → did\nI got up late yesterday."
        },
        {
          "label_fa": "منفی",
          "text": "didn't + base verb\nI didn't get up late.\nHe didn't go to work by car."
        },
        {
          "label_fa": "سؤالی",
          "text": "Did + subject + base verb?\nDid you get up late?\nWhat time did you get up?"
        }
      ],
      "examples": [
        {
          "en": "I got up late yesterday.",
          "fa": "دیروز دیر بیدار شدم."
        },
        {
          "en": "He went to work by car.",
          "fa": "او با ماشین سر کار رفت."
        },
        {
          "en": "She had eggs for breakfast.",
          "fa": "او صبحانه تخم‌مرغ خورد."
        },
        {
          "en": "We did yoga yesterday.",
          "fa": "ما دیروز یوگا کردیم."
        }
      ],
      "notes_fa": "بعد از didn't و did شکل گذشته نمی‌آید: didn't go (نه didn't went) و Did you have ...? (نه Did you had ...?)."
    }
  ],
