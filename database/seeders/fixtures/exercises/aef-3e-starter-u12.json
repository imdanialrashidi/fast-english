  "topics": [
    {
      "key": "t1",
      "position": 1,
      "title_en": "simple past: regular and irregular verbs",
      "title_fa": "گذشتهٔ ساده: افعال باقاعده و بی‌قاعده",
      "use_fa": "برای کارهای تمام‌شده در گذشته. باقاعده‌ها ed می‌گیرند و بی‌قاعده‌ها شکل خودشان را دارند؛ فعل be هم was/were می‌شود.",
      "formulas": [
        {
          "label_fa": "باقاعده",
          "text": "play → played\nwork → worked\nstay → stayed"
        },
        {
          "label_fa": "بی‌قاعده",
          "text": "go → went\nsee → saw\nhave → had\nbuy → bought\nbe → was / were"
        },
        {
          "label_fa": "سؤالی/منفی",
          "text": "Did you like the movie?\nI didn't play tennis yesterday.\nWas she tired?"
        }
      ],
      "examples": [
        {
          "en": "I played tennis yesterday.",
          "fa": "دیروز تنیس بازی کردم."
        },
        {
          "en": "She went to New York last year.",
          "fa": "او سال گذشته به نیویورک رفت."
        },
        {
          "en": "We saw a movie last night.",
          "fa": "دیشب فیلم دیدیم."
        },
        {
          "en": "He was a teacher.",
          "fa": "او معلم بود."
        }
      ],
      "notes_fa": "گذشتهٔ be: I/he/she/it was و you/we/they were. برای فعل‌های دیگر، سؤال و منفی با did/didn't و فعل پایه ساخته می‌شود: Did you see ...? / didn't see."
    },
    {
      "key": "t2",
      "position": 2,
      "title_en": "review the past simple",
      "title_fa": "مرور گذشتهٔ ساده",
      "use_fa": "مرور پرسیدن و منفی کردن در گذشته و عبارت‌های زمانی گذشته.",
      "formulas": [
        {
          "label_fa": "سؤال با did",
          "text": "Did + subject + base verb?\nWhere did they stay?\nDid you like it?"
        },
        {
          "label_fa": "سؤال با be",
          "text": "Was / Were + subject?\nWas she tired?\nWere they at school?"
        },
        {
          "label_fa": "زمان گذشته",
          "text": "yesterday\nlast night / last week / last year\nin 2010"
        }
      ],
      "examples": [
        {
          "en": "Did you like the movie? — Yes, I did.",
          "fa": "فیلم را دوست داشتی؟ — بله."
        },
        {
          "en": "Where did they stay in New York?",
          "fa": "آن‌ها در نیویورک کجا ماندند؟"
        },
        {
          "en": "Was she tired? — No, she wasn't.",
          "fa": "او خسته بود؟ — نه."
        },
        {
          "en": "We stayed in a hotel last week.",
          "fa": "هفتهٔ گذشته در هتل ماندیم."
        }
      ],
      "notes_fa": "بعد از did/didn't فعل پایه می‌آید. در سؤال با be جای فاعل و فعل عوض می‌شود: She was tired. → Was she tired?"
    }
  ],
