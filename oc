#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

set -a
source "$ROOT_DIR/.opencode/models.env"
set +a

export OPENCODE_EXPERIMENTAL_LSP_TOOL=true

cd "$ROOT_DIR"

# وقتی Subcommand داریم، آن را بدون --auto اجرا کن.
if (( $# > 0 )); then
  exec opencode "$@"
fi

# فقط اجرای معمول TUI در Auto mode باشد.
exec opencode --auto
