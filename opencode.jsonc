{
  "$schema": "https://opencode.ai/config.json",

  // Models remain replaceable from one local file loaded by ./oc.
  "model": "{env:OC_MAIN_MODEL}",
  "small_model": "{env:OC_FAST_MODEL}",
  "default_agent": "build",

  // Primary agent -> one bounded mechanical subagent. No nested agent trees.
  "subagent_depth": 1,

  "share": "disabled",
  "snapshot": true,
  "autoupdate": "notify",
  "formatter": true,
  "lsp": true,

  // Native image attachments are sent directly to vision-capable models.
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 2000,
      "max_height": 2000,
      "max_base64_bytes": 5242880
    }
  },

  // Keep long autonomous debugging sessions useful without retaining every
  // historical tool result forever.
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 3,
    "reserved": 12000
  },

  // Large outputs are saved by OpenCode and represented by a shorter preview.
  "tool_output": {
    "max_lines": 1400,
    "max_bytes": 90000
  },

  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/node_modules/**",
      "**/.venv/**",
      "**/vendor/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/target/**",
      "**/.next/**",
      "**/.turbo/**",
      "**/.vite/**",
      "**/generated/**",
      "**/playwright-report/**",
      "**/test-results/**",
      "**/server/pb_data/**",
      "**/.gradle/**"
    ]
  },

  // Context7 is remote and authenticated with OAuth.
  // Playwright runs locally, headless and isolated, and is restricted to local
  // development origins. Do not enable unrestricted file access or no-sandbox.
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp/oauth",
      "enabled": true,
      "timeout": 20000
    },

    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--image-responses",
        "omit",
        "--console-level",
        "warning",
        "--allowed-origins",
        "http://localhost:*;http://127.0.0.1:*;https://localhost:*;https://127.0.0.1:*",
        "--timeout-action",
        "10000",
        "--timeout-navigation",
        "90000"
      ],
      "enabled": true,
      "timeout": 20000
    }
  },

  // MCPs are started, but their tool schemas are exposed only to agents that
  // actually need them. This is the documented per-agent MCP gating pattern.
  "tools": {
    "context7_*": false,
    "playwright_*": false
  },

  // Autonomous by default: ordinary coding, package installation, tests,
  // local servers, curl, adb, Gradle and browser checks run without approval.
  // Explicit denies protect irreversible or externally consequential actions.
  "permission": {
    "*": "allow",

    // Do not interrupt routine work with implementation-choice questions.
    // For a true hard blocker, the agent must stop and report the exact blocker.
    "question": "deny",

    // Allow OpenCode to recover automatically when it detects repeated calls.
    "doom_loop": "allow",

    // MCP tools are opt-in per agent below.
    "context7_*": "deny",
    "playwright_*": "deny",

    // Arbitrary JavaScript in the Playwright server is RCE-equivalent.
    "playwright_browser_run_code_unsafe": "deny",

    "read": {
      "*": "allow",

      // Real environment and credential files are denied by default.
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*secret*": "deny",
      "**/*credential*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.jks": "deny",
      "**/*.keystore": "deny",
      "**/playwright/.auth/**": "deny",
      "**/storageState*.json": "deny",
      "**/.git/**": "deny",
      "**/server/pb_data/**": "deny",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.aws/**": "deny",
      "~/.kube/**": "deny",
      "~/.config/gcloud/**": "deny",
      "~/.android/adbkey*": "deny",
      "~/.android/*.keystore": "deny",

      // Explicitly non-production local configuration may be read for debugging.
      // Never put production secrets in these files.
      "**/.env.example": "allow",
      "**/.env.local": "allow",
      "**/.env.development": "allow",
      "**/.env.development.local": "allow",
      "**/.env.test": "allow",
      "**/.env.test.local": "allow"
    },

    "edit": {
      "*": "allow",

      // Protect the workflow and generated/sensitive material from direct edits.
      "opencode.json": "deny",
      "opencode.jsonc": "deny",
      ".opencode/**": "deny",
      "AGENTS.md": "deny",
      "**/.git/**": "deny",
      "**/node_modules/**": "deny",
      "**/vendor/**": "deny",
      "**/dist/**": "deny",
      "**/build/**": "deny",
      "**/coverage/**": "deny",
      "**/target/**": "deny",
      "**/.next/**": "deny",
      "**/.turbo/**": "deny",
      "**/.vite/**": "deny",
      "**/playwright-report/**": "deny",
      "**/test-results/**": "deny",
      "**/server/pb_data/**": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*secret*": "deny",
      "**/*credential*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.jks": "deny",
      "**/*.keystore": "deny",
      "**/playwright/.auth/**": "deny",
      "**/storageState*.json": "deny",

      // Safe example configuration may be maintained by the agent.
      "**/.env.example": "allow",

      // External caches/SDKs are readable/executable, not directly editable.
      "~/.cache/**": "deny",
      "~/.npm/**": "deny",
      "~/.pnpm-store/**": "deny",
      "~/.local/share/pnpm/**": "deny",
      "~/.gradle/**": "deny",
      "~/Android/Sdk/**": "deny",
      "~/.android/**": "deny",
      "/tmp/**": "deny"
    },

    // Narrow, trusted external development locations required by npx,
    // Playwright, pnpm, Gradle, Android SDK and temporary test artifacts.
    "external_directory": {
      "*": "deny",
      "/tmp/**": "allow",
      "~/.cache/**": "allow",
      "~/.npm/**": "allow",
      "~/.pnpm-store/**": "allow",
      "~/.local/share/pnpm/**": "allow",
      "~/.gradle/**": "allow",
      "~/Android/Sdk/**": "allow",
      "~/.android/**": "allow"
    },

    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "todowrite": "allow",

    "bash": {
      "*": "allow",

      // Privilege escalation and host/service mutation.
      "sudo *": "deny",
      "su *": "deny",
      "doas *": "deny",
      "pkexec *": "deny",
      "systemctl *": "deny",
      "service *": "deny",
      "crontab *": "deny",

      // Generic recursive deletion is blocked. Known generated directories are
      // allowed below so normal debugging and clean rebuilds remain autonomous.
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "rm -r *": "deny",
      "find * -delete*": "deny",
      "shred *": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "mount *": "deny",
      "umount *": "deny",
      "chown *": "deny",
      "chmod -R 777 *": "deny",

      "rm -rf node_modules": "allow",
      "rm -rf node_modules/": "allow",
      "rm -rf ./node_modules": "allow",
      "rm -rf ./node_modules/": "allow",
      "rm -rf dist": "allow",
      "rm -rf dist/": "allow",
      "rm -rf ./dist": "allow",
      "rm -rf build": "allow",
      "rm -rf build/": "allow",
      "rm -rf ./build": "allow",
      "rm -rf coverage": "allow",
      "rm -rf coverage/": "allow",
      "rm -rf .next": "allow",
      "rm -rf .next/": "allow",
      "rm -rf .turbo": "allow",
      "rm -rf .turbo/": "allow",
      "rm -rf .vite": "allow",
      "rm -rf .vite/": "allow",
      "rm -rf target": "allow",
      "rm -rf target/": "allow",
      "rm -rf playwright-report": "allow",
      "rm -rf playwright-report/": "allow",
      "rm -rf test-results": "allow",
      "rm -rf test-results/": "allow",
      "rm -rf android/app/build": "allow",
      "rm -rf android/app/build/": "allow",
      "rm -rf android/.gradle": "allow",
      "rm -rf android/.gradle/": "allow",

      // Preserve user-controlled history and releases.
      "git commit*": "deny",
      "git push*": "deny",
      "git pull*": "deny",
      "git reset *": "deny",
      "git clean*": "deny",
      "git checkout *": "deny",
      "git switch *": "deny",
      "git restore *": "deny",
      "git stash *": "deny",
      "git rebase*": "deny",
      "git merge*": "deny",
      "git cherry-pick*": "deny",
      "git branch -D*": "deny",
      "git tag*": "deny",
      "git worktree remove*": "deny",
      "git remote set-url*": "deny",
      "git remote remove*": "deny",

      // No global package installation, publishing or remote script execution.
      "npm install -g *": "deny",
      "npm i -g *": "deny",
      "npm publish*": "deny",
      "npm version*": "deny",
      "pnpm add -g *": "deny",
      "pnpm install -g *": "deny",
      "pnpm publish*": "deny",
      "pnpm version*": "deny",
      "yarn global *": "deny",
      "yarn npm publish*": "deny",
      "bun publish*": "deny",
      "cargo publish*": "deny",
      "twine upload*": "deny",
      "curl *|*sh*": "deny",
      "curl *|*bash*": "deny",
      "wget *|*sh*": "deny",
      "wget *|*bash*": "deny",

      // No remote shell, external release, infrastructure or production deploy.
      "ssh *": "deny",
      "scp *": "deny",
      "sftp *": "deny",
      "rsync *:*": "deny",
      "docker push*": "deny",
      "docker system prune*": "deny",
      "docker volume prune*": "deny",
      "kubectl *": "deny",
      "helm *": "deny",
      "terraform apply*": "deny",
      "terraform destroy*": "deny",
      "terraform import*": "deny",
      "terraform state rm*": "deny",
      "ansible-playbook*": "deny",
      "vercel deploy*": "deny",
      "netlify deploy*": "deny",
      "wrangler deploy*": "deny",
      "fly deploy*": "deny",
      "firebase deploy*": "deny",
      "supabase db push*": "deny",
      "gh release create*": "deny",
      "gh pr create*": "deny",
      "gh pr merge*": "deny",
      "gh issue create*": "deny",
      "gh repo delete*": "deny"
    }
  },

  "agent": {
    "build": {
      "description": "Autonomous primary implementation and debugging agent. Inspects the repository, runs real local services, reproduces failures, implements the bounded task, verifies it end to end, and continues until completion or a true hard blocker.",
      "mode": "primary",
      "model": "{env:OC_MAIN_MODEL}",
      "temperature": 0.1,
      "prompt": "{file:.opencode/prompts/build.md}",

      // Intentionally no steps limit: long debugging sessions must not be
      // converted into a premature text-only status report.
      "tools": {
        "context7_*": true,
        "playwright_*": true,
        "playwright_browser_run_code_unsafe": false
      },

      "permission": {
        "question": "deny",
        "doom_loop": "allow",

        "context7_*": "allow",
        "playwright_*": "allow",
        "playwright_browser_run_code_unsafe": "deny",

        "task": {
          "*": "deny",
          "fast": "allow"
        },

        "skill": {
          "*": "deny",
          "risk-review": "allow"
        }
      }
    },

    "plan": {
      "description": "Architecture, planning and risk agent. Reads code and current dependency documentation, but cannot change application code or run mutating shell workflows.",
      "mode": "primary",
      "model": "{env:OC_ARCH_MODEL}",
      "temperature": 0.1,
      "prompt": "{file:.opencode/prompts/plan.md}",

      "tools": {
        "context7_*": true,
        "playwright_*": false
      },

      "permission": {
        "question": "deny",
        "context7_*": "allow",
        "playwright_*": "deny",

        "edit": {
          "*": "deny",
          "README.md": "allow",
          "docs/PRODUCT.md": "allow",
          "docs/ARCHITECTURE.md": "allow",
          "docs/PLAN.md": "allow",
          "docs/DECISIONS.md": "allow",
          "docs/BACKEND.md": "allow",
          "docs/PWA.md": "allow",
          "docs/ANDROID_PHASE.md": "allow",
          "docs/TEST_CHECKLIST.md": "allow",
          ".opencode/plans/**": "allow",
          ".opencode/Plans/**": "allow"
        },

        "task": "deny",

        "skill": {
          "*": "deny",
          "risk-review": "allow"
        },

        // Built-in read/glob/grep and Context7 handle nearly all planning.
        // Only non-mutating repository/environment diagnostics are permitted.
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git branch --show-current": "allow",
          "git remote -v": "allow",
          "node --version*": "allow",
          "npm --version*": "allow",
          "pnpm --version*": "allow",
          "bun --version*": "allow",
          "python --version*": "allow",
          "python3 --version*": "allow",
          "go version*": "allow",
          "rustc --version*": "allow",
          "cargo --version*": "allow",
          "java -version*": "allow",
          "adb version*": "allow",
          "npm ls*": "allow",
          "npm view*": "allow",
          "pnpm list*": "allow",
          "pnpm why*": "allow"
        }
      }
    },

    "vision": {
      "description": "Native multimodal inspection agent for images, screenshots, mockups, diagrams, visual regressions, responsive layouts, RTL/LTR and accessibility. Switch to it with Tab whenever direct visual understanding is required.",
      "mode": "primary",
      "model": "{env:OC_VISION_MODEL}",
      "variant": "{env:OC_VISION_VARIANT}",
      "options": {
        "reasoningEffort": "{env:OC_VISION_REASONING_EFFORT}",
        "textVerbosity": "low",
        "reasoningSummary": "auto"
      },
      "color": "info",
      "steps": 32,
      "prompt": "{file:.opencode/prompts/vision.md}",

      "tools": {
        "context7_*": false,
        "playwright_*": true,
        "playwright_browser_run_code_unsafe": false
      },

      "permission": {
        "question": "deny",
        "edit": "deny",
        "task": "deny",
        "skill": "deny",

        "context7_*": "deny",
        "playwright_*": "allow",
        "playwright_browser_run_code_unsafe": "deny",

        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow"
        }
      }
    },

    "general": { "disable": true },
    "explore": { "disable": true },
    "scout": { "disable": true },

    "fast": {
      "description": "Bounded subagent for mechanical, low-risk repository work delegated by the primary agent.",
      "mode": "subagent",
      "model": "{env:OC_FAST_MODEL}",
      "temperature": 0.1,
      "prompt": "{file:.opencode/prompts/fast.md}",

      "tools": {
        "context7_*": false,
        "playwright_*": false
      },

      "permission": {
        // Inherit global granular read/edit protections. Do not replace them
        // with shorthand "allow", which would expose secrets and workflow files.
        "bash": "deny",
        "task": "deny",
        "skill": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "question": "deny",
        "external_directory": "deny",
        "context7_*": "deny",
        "playwright_*": "deny"
      }
    }
  },

  // If a dangerous action is denied, let the agent continue and find a safe,
  // reversible alternative instead of ending the whole session.
  "experimental": {
    "continue_loop_on_deny": true
  }
}
