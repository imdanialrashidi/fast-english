{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node"]
  },
  "include": ["server/pb_hooks/**/*.pb.js", "server/pb_hooks/goja.d.ts"],
  "exclude": ["server/pb_data", "server/pb_data.bak", "node_modules", "dist-*"]
}
